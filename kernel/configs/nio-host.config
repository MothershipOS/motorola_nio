# Early SM8250/KVM baseline; not a complete nio product configuration.
CONFIG_KVM=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PSI=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_VHOST=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y
CONFIG_VSOCKETS=y
CONFIG_TUN=y
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_IPV6=y
CONFIG_BRIDGE=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_TYPEC=y
CONFIG_DRM=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_PINCTRL_SM8250=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_SCM=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_ARM_SMMU=y
# Bring-up observability: on-screen console over the bootloader splash buffer,
# reboot-mode handoff back to fastboot, and the APSS watchdog if left running.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT_CONSOLE=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_LOG_BUF_SHIFT=20
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-mothership-nio-dev"
# Adreno 650 GPU at EL2 (headless first; display/DPU follows)
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DP=y
CONFIG_QCOM_LLCC=y
CONFIG_SM_GPUCC_8250=y
CONFIG_QCOM_OCMEM=y
CONFIG_VFIO=y
CONFIG_VFIO_PLATFORM=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_FREEZER=y
# removable media (microSD backup target)
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
# A4 display (mothershipOS, 2026-10-11)
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_REGULATOR_QCOM_PM8150L_LCDB=y
CONFIG_DRM_PANEL_TIANMA_NT36672C_NIO=y
# boot console on the panel (patch 0005); ttyMSM0 last so /dev/console stays on the UART
CONFIG_CMDLINE="console=tty0 console=ttyMSM0,115200n8 fbcon=font:TER16x32"
# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
CONFIG_CMDLINE_EXTEND=y
# touch (patch 0006): spi13 on QUP1 SE5, SE firmware loaded by Linux from qupv3fw.elf
CONFIG_SPI_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_TOUCHSCREEN_NOVATEK_NT36XXX_SPI=y
# USB3 (patch 0007): CC orientation -> QMP PHY; i2c15 for the NB7VPQ904M redriver
CONFIG_TYPEC_QCOM_PMIC_CC_ORIENTATION=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_TYPEC_MUX_NB7VPQ904M=y
# camera (patch 0008): camcc, CCI, CAMSS, media core built in; WL2864C + OV64B
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_SM_CAMCC_8250=y
CONFIG_I2C_QCOM_CCI=y
CONFIG_VIDEO_QCOM_CAMSS=y
CONFIG_REGULATOR_WL2864C=y
CONFIG_VIDEO_OV64B=y
CONFIG_VIDEO_MOTCAM=m
# dma-buf providers: libcamera's software ISP allocates its buffers from them (and crosvm can use udmabuf). No CMA
# heap: libcamera prefers it and does not fall back, and the 32 MB CMA pool is too small for a 1080p pipeline
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
# CONFIG_DMABUF_HEAPS_CMA is not set
CONFIG_UDMABUF=y
# the rear flash (PM8150L, two channels): torch for the cameras and the flashlight
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_QCOM_FLASH=m
# synthetic input for testing touch/key paths without a finger (tools/touchinject)
CONFIG_INPUT_UINPUT=y

# mothershipOS: PM8150B charger + fuel gauge
CONFIG_CHARGER_QCOM_PM8150B=m
CONFIG_UHID=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
# USB handle tests without a cable (archive/prototypes/usb/usb-test-device.sh): virtual host controller + UDC
CONFIG_USB_DUMMY_HCD=m

# VM networking: mship-system net's iptables-legacy chains (filter, NAT/masquerade, mangle; v4 and v6)
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
# BNEP filters (Bluetooth PAN)
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
# f2fs: Android partition images (the PixelOS VM's disk)
CONFIG_F2FS_FS=m
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_IOSTAT=y
# Modem (SDX55 on PCIe2, MHI): the host serves its boot images over Sahara (patch 0026)
CONFIG_MHI_SAHARA=m
