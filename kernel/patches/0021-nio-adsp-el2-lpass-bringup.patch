-	if (attempted || !is_kernel_in_hyp_mode() ||
-	    !of_property_read_bool(dev->of_node, "mothership,el2-cmdb-before-bridge-test"))
+	if (of_property_read_bool(dev->of_node, "mothership,el2-cmdb-share-adsp"))
+		nio_cmdb_share_adsp = true;
+	if (attempted || !is_kernel_in_hyp_mode() || (!nio_cmdb_share_adsp &&
+	    !of_property_read_bool(dev->of_node, "mothership,el2-cmdb-before-bridge-test")))
 		return;
 	attempted = true;
 	node = of_find_compatible_node(NULL, NULL, "qcom,cmd-db");
@@ -1778,6 +1797,13 @@ static void nio_cmdb_before_bridge_test(struct device *dev)
 	wmb();
 	arm_smccc_smc(0xc2000c16, 0x1117, pa+64, 16, pa, pa+192, 0, 3, &result);
 	dev_info(dev, "nio early CMD-DB: RO share a0=%#lx a1=%#lx\n", result.a0, result.a1);
+	if (!result.a0 && !result.a1 && (nio_cmdb_share_adsp ||
+	    of_property_read_bool(dev->of_node, "mothership,el2-cmdb-hold-for-adsp-test"))) {
+		WRITE_ONCE(nio_cmdb_early_owners_available, true);
+		dev_info(dev, "nio early CMD-DB: shared read-only with HLOS+ADSP\n");
+		dma_free_coherent(dev, PAGE_SIZE, buf, pa);
+		return;
+	}
 	if (!result.a0 && !result.a1) {
 		src[1] = cpu_to_le32(6);
 		memset(dest, 0, 48); dest[0] = cpu_to_le32(3); dest[1] = cpu_to_le32(4);
