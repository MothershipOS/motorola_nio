+/* mothershipOS: EL2 replacement for QHEE's boot-time CMD-DB sharing with the ADSP (HLOS+ADSP RO,
+ * kept), selectable on the kernel command line so it can be kexec-tested with the running DT. */
+static bool nio_cmdb_share_adsp;
+module_param(nio_cmdb_share_adsp, bool, 0400);
+MODULE_PARM_DESC(nio_cmdb_share_adsp, "EL2: share CMD-DB read-only with the ADSP before SHM bridge enable");
+
+static bool nio_cmdb_early_owners_available;
+
+int qcom_scm_nio_cmdb_test_take_owners(u64 *owners)
+{
+	if (!xchg(&nio_cmdb_early_owners_available, false))
+		return -ENOENT;
+	*owners = BIT_ULL(3) | BIT_ULL(6);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_nio_cmdb_test_take_owners);
+
 static u64 nio_cmdb_early_bridge;
 static bool nio_cmdb_early_bridge_available;
 
