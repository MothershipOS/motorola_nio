+++ b/drivers/firmware/qcom/qcom_scm-smc.c
@@ -235,6 +235,12 @@ int __scm_smc_call(struct device *dev, const struct qcom_scm_desc *desc,
 	if (ret)
 		return ret;
 
+	/* mothershipOS debug: raw TZ result of MEM_ASSIGN (svc 0x0c cmd 0x16) */
+	if ((smc.args[0] & 0xffff) == 0x0c16)
+		pr_info("qcom_scm: MEM_ASSIGN fid %#lx arginfo %#lx x2..x5 %#lx %#lx %#lx %#lx -> a0 %#lx a1 %#lx a2 %#lx a3 %#lx\n",
+			smc.args[0], smc.args[1], smc.args[2], smc.args[3], smc.args[4], smc.args[5],
+			smc_res.a0, smc_res.a1, smc_res.a2, smc_res.a3);
+
 	if (res) {
 		res->result[0] = smc_res.a1;
 		res->result[1] = smc_res.a2;
