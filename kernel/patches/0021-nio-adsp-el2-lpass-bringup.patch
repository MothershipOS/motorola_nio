-		new_owners |= BIT_ULL(dest[i].vmid);
-	}
-	extra[0] = cpu_to_le64(4*n);
-	extra[1] = cpu_to_le64(pa + 128);
-	extra[2] = cpu_to_le64(24*count);
-
-	ret = qcom_scm_assign_mem(pa, PAGE_SIZE, &descriptor_owners,
