-/* Diagnostic only: disabled unless root explicitly opts in at runtime. */
-static bool nio_el2_cmdb_early_bridge;
-module_param(nio_el2_cmdb_early_bridge, bool, 0600);
-MODULE_PARM_DESC(nio_el2_cmdb_early_bridge, "Consume early HLOS-only RO bridge for bounded CMD-DB test");
+/*
+ * mothershipOS: with Linux at EL2 there is no QHEE. On stock nio, QHEE handles the ADSP
+ * auth_and_reset call (pil_auth_reset_api_ns) as memAssign -> TZ auth -> PILSubsys_bringUp, and
+ * bringUp is what actually clocks and starts the LPASS Q6: TZ alone authenticates but leaves the
+ * core stopped. Port of QHEE's LPASS bringUp (ClockSetup(0), boot vector, ClockEnable(0)).
+ * QHEE's other duties are in the DT: CMD-DB/SMEM sharing (qcom_scm) and SID 0x1800 (apps SMMU).
+ */
+static bool nio_lpass_bringup = true;
+module_param(nio_lpass_bringup, bool, 0600);
+MODULE_PARM_DESC(nio_lpass_bringup, "EL2: start the LPASS Q6 after TZ auth, as QHEE does");
 
-static bool nio_el2_cmdb_start_test;
-module_param(nio_el2_cmdb_start_test, bool, 0600);
-MODULE_PARM_DESC(nio_el2_cmdb_start_test, "Explicitly approved CMD-DB RO sharing during bounded ADSP test only");
+#define NIO_Q6SS		0x03000000	/* QDSP6SS */
+#define NIO_LPASS_AON		0x03380000
+#define NIO_LPASS_CORE		0x03c00000
+#define NIO_LPASS_MEM		0x03555000
+#define NIO_LPASS_EFUSE		0x0355b000
+
+static void nio_rmw(void __iomem *r, u32 keep, u32 set)
+{
+	writel((readl(r) & keep) | set, r);
+}
 
-static bool nio_el2_image_hyp_caller;
-module_param(nio_el2_image_hyp_caller, bool, 0600);
-MODULE_PARM_DESC(nio_el2_image_hyp_caller, "Use private VMID4-registered descriptors for bounded ADSP test");
+/* CBCR: enable unless under HW control, then wait for CLK_OFF (bit 31) to clear */
+static int nio_cbcr_on(void __iomem *r, u32 keep)
+{
+	u32 v;
 
-static bool nio_el2_image_start_test;
-module_param(nio_el2_image_start_test, bool, 0600);
-MODULE_PARM_DESC(nio_el2_image_start_test, "Bounded nio ADSP image-sharing startup test; always shutdown and restore");
+	nio_rmw(r, keep, BIT(0));
+	if (readl(r) & BIT(1))
+		return 0;
+	return readl_poll_timeout_atomic(r, v, !(v & BIT(31)), 1, 500);
+}
+
+/*
+ * A running Q6 without QHEE's other duties resets the SoC (blocked SID 0x1800 fetches, CMD-DB access
+ * violation). Only start it when the DT provides both, so an older boot image just times out instead.
+ */
+static bool nio_lpass_prerequisites(struct device *dev)
+{
+	struct iommu_domain *domain = iommu_get_domain_for_dev(dev);
+	struct device_node *scm = of_find_node_by_path("/firmware/scm");
+	bool cmdb = scm && of_property_read_bool(scm, "mothership,el2-cmdb-share-adsp");
+
+	of_node_put(scm);
+	if (domain && domain->type == IOMMU_DOMAIN_IDENTITY && cmdb)
+		return true;
+	dev_warn(dev, "nio lpass: not starting Q6 (identity SMMU %d, CMD-DB share %d)\n",
+		 domain && domain->type == IOMMU_DOMAIN_IDENTITY, cmdb);
+	return false;
+}
+
+static int nio_lpass_bring_up(struct device *dev, phys_addr_t boot)
+{
+	void __iomem *q6ss, *aon, *core, *mem, *efuse;
+	u32 saved, v;
+	int ret = -ENOMEM;
+
+	q6ss = ioremap(NIO_Q6SS, 0x1000);
+	aon = ioremap(NIO_LPASS_AON, 0xb000);
+	core = ioremap(NIO_LPASS_CORE, 0x9000);
+	mem = ioremap(NIO_LPASS_MEM, 0x1000);
+	efuse = ioremap(NIO_LPASS_EFUSE, 0x10);
+	if (!q6ss || !aon || !core || !mem || !efuse)
+		goto out;
+
+	/* QHEE ClockSetup(LPASS) */
+	nio_rmw(core + 0x8000, 0x80000001, 0);
+	ret = nio_cbcr_on(aon + 0x901c, 0x80000006);
+	if (!ret)
+		ret = nio_cbcr_on(aon + 0x9020, 0x80000006);
+	if (ret) { dev_err(dev, "nio lpass: AON clocks: %d\n", ret); goto out; }
+	saved = readl(q6ss + 0x18);
+	nio_rmw(aon + 0x3090, 0xf8ffffff, 0xf000);
+	nio_rmw(core + 0x4000, 0x80000000, BIT(0));
+	readl(core + 0x4000);
+	ret = readl_poll_timeout_atomic(core + 0x4000, v, !(v & BIT(31)), 1, 500);
+	if (!ret)
+		ret = nio_cbcr_on(aon + 0x901c, 0x80000006);
+	if (!ret)
+		ret = nio_cbcr_on(aon + 0x9020, 0x80000006);
+	if (ret) { dev_err(dev, "nio lpass: core clock: %d\n", ret); goto out; }
+	nio_rmw(q6ss + 0x38, 0x80000000, BIT(0));	/* XO_CBCR */
+	nio_rmw(q6ss + 0x3c, 0x80000000, BIT(0));	/* SLEEP_CBCR */
+	nio_rmw(q6ss + 0x20, 0x80000000, BIT(0));	/* CORE_CBCR */
+	writel(saved & 0xffff0002, q6ss + 0x18);
+	if (saved & 0xffff0002) {
+		nio_rmw(aon + 0xa00c, 0x80007ff4, BIT(0));
+		nio_rmw(aon + 0xa014, 0x80000004, BIT(0));
+	}
+	nio_rmw(mem + 0x14, 0x3, 0x4);
+	nio_rmw(mem + 0x18, 0x3, 0x4);
+	nio_rmw(mem + 0x20, 0x3, 0x4);
+	if (readl_poll_timeout_atomic(mem + 0x20, v, v & BIT(0), 1, 1000))
+		dev_dbg(dev, "nio lpass: memory power status %#x\n", v);
+	nio_rmw(core + 0x8000, 0x80000001, BIT(1));
+
+	/* boot vector: RST_EVB[27:4] = boot[31:8], then select it in the LPASS efuse override */
+	nio_rmw(q6ss + 0x10, (u32)~GENMASK(27, 4), ((u32)boot >> 8) << 4);
+	nio_rmw(efuse, (u32)~BIT(0), 0);
+	dsb(sy);
+
+	/* QHEE ClockEnable(LPASS): CORE_START, BOOT_CMD, wait for BOOT_STATUS */
+	readl(q6ss + 0x400);
+	writel(1, q6ss + 0x400);
+	writel(1, q6ss + 0x404);
+	ret = readl_poll_timeout(q6ss + 0x408, v, v & BIT(0), 5, 1000000);
+	dev_info(dev, "nio lpass: boot %pa evb=%#x status=%#x saved18=%#x ret=%d\n",
+		 &boot, readl(q6ss + 0x10), v, saved, ret);
+out:
+	if (efuse) iounmap(efuse);
+	if (mem) iounmap(mem);
+	if (core) iounmap(core);
+	if (aon) iounmap(aon);
+	if (q6ss) iounmap(q6ss);
+	return ret;
+}
 
