--- a/include/linux/phy/phy-qcom-qmp-combo.h
+++ b/include/linux/phy/phy-qcom-qmp-combo.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * mothershipOS: the QMP USB3/DP combo PHY tells the USB controller's glue when its USB3 half goes away (Type-C DP
+ * pin assignment C/E: all four lanes are DisplayPort) and when it comes back. A Qualcomm dwc3 then has to run
+ * its PIPE side from the UTMI clock, or even USB 2.0 stops working.
+ */
+#ifndef __PHY_QCOM_QMP_COMBO_H
+#define __PHY_QCOM_QMP_COMBO_H
+
+#include <linux/notifier.h>
+
+/* notifier actions; the data pointer is the PHY's struct device */
+#define QMP_COMBO_USB3_GONE	1
+#define QMP_COMBO_USB3_BACK	2
+
+#if IS_ENABLED(CONFIG_PHY_QCOM_QMP_COMBO)
+int qcom_qmp_combo_usb3_notifier_register(struct notifier_block *nb);
+int qcom_qmp_combo_usb3_notifier_unregister(struct notifier_block *nb);
+#else
+static inline int qcom_qmp_combo_usb3_notifier_register(struct notifier_block *nb) { return 0; }
+static inline int qcom_qmp_combo_usb3_notifier_unregister(struct notifier_block *nb) { return 0; }
+#endif
+
+#endif
