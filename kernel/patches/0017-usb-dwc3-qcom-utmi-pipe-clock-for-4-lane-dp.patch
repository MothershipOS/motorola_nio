+/* mothershipOS: back to the QMP PHY's PIPE clock (reverse of dwc3_qcom_select_utmi_clk) */
+static void dwc3_qcom_select_pipe_clk(struct dwc3_qcom *qcom)
+{
+	dwc3_qcom_setbits(qcom->qscratch_base, QSCRATCH_GENERAL_CFG,
+			  PIPE_UTMI_CLK_DIS);
+
+	usleep_range(100, 1000);
+
+	dwc3_qcom_clrbits(qcom->qscratch_base, QSCRATCH_GENERAL_CFG,
+			  PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW);
+
+	usleep_range(100, 1000);
+
+	dwc3_qcom_clrbits(qcom->qscratch_base, QSCRATCH_GENERAL_CFG,
+			  PIPE_UTMI_CLK_DIS);
+}
+
+/*
+ * mothershipOS: with a DP-only pin assignment (4-lane DisplayPort over Type-C) the QMP combo PHY powers its USB3
+ * half off, and with it the PIPE clock the controller runs from: even USB 2.0 devices (a monitor's hub) no
+ * longer enumerate. Run the PIPE side from the UTMI clock while USB3 is gone, back from the PHY afterwards, and
+ * restart the controller's current role so it comes up on the new clock (as Qualcomm's downstream dwc3-msm).
+ */
+static void dwc3_qcom_usb3_work(struct work_struct *work)
+{
+	struct dwc3_qcom *qcom = container_of(work, struct dwc3_qcom, usb3_work);
+	struct dwc3 *dwc = platform_get_drvdata(qcom->dwc3);
+	u32 role;
+
+	if (qcom->usb3_gone)
+		dwc3_qcom_select_utmi_clk(qcom);
+	else
+		dwc3_qcom_select_pipe_clk(qcom);
+
+	if (!dwc || dwc->dr_mode != USB_DR_MODE_OTG)
+		return;
+	role = dwc->desired_dr_role ? dwc->desired_dr_role : dwc->current_dr_role;
+	if (role != DWC3_GCTL_PRTCAP_HOST && role != DWC3_GCTL_PRTCAP_DEVICE)
+		return;
+	dwc3_set_mode(dwc, role == DWC3_GCTL_PRTCAP_HOST ? DWC3_GCTL_PRTCAP_DEVICE : DWC3_GCTL_PRTCAP_HOST);
+	flush_work(&dwc->drd_work);
+	dwc3_set_mode(dwc, role);
+	flush_work(&dwc->drd_work);
+	dev_info(qcom->dev, "USB3 PHY %s: PIPE clock from %s, %s restarted\n",
+		 qcom->usb3_gone ? "gone (DP only)" : "back", qcom->usb3_gone ? "UTMI" : "the PHY",
+		 role == DWC3_GCTL_PRTCAP_HOST ? "host" : "device");
+}
+
+static int dwc3_qcom_usb3_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct dwc3_qcom *qcom = container_of(nb, struct dwc3_qcom, usb3_nb);
+	struct device *phy_dev = data;
+
+	if (!phy_dev || phy_dev->of_node != qcom->usb3_phy_np)
+		return NOTIFY_DONE;
+	qcom->usb3_gone = action == QMP_COMBO_USB3_GONE;
+	schedule_work(&qcom->usb3_work);	/* the PHY calls us with its mutex held */
+	return NOTIFY_OK;
+}
+
+static void dwc3_qcom_usb3_follow_phy(struct dwc3_qcom *qcom)
+{
+	struct device_node *dwc3_np = qcom->dwc3->dev.of_node;
+	struct of_phandle_args args;
+	int idx = of_property_match_string(dwc3_np, "phy-names", "usb3-phy");
+
+	if (idx < 0 || of_parse_phandle_with_args(dwc3_np, "phys", "#phy-cells", idx, &args))
+		return;
+	qcom->usb3_phy_np = args.np;
+	INIT_WORK(&qcom->usb3_work, dwc3_qcom_usb3_work);
+	qcom->usb3_nb.notifier_call = dwc3_qcom_usb3_notify;
+	qcom_qmp_combo_usb3_notifier_register(&qcom->usb3_nb);
+}
