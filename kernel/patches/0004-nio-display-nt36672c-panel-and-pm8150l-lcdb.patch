--- /dev/null
+++ b/drivers/regulator/qcom-pm8150l-lcdb.c
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal PM8150L LCDB (LCD bias: boost + LDO + NCP) enable switch for mothershipOS / Motorola nio.
+ *
+ * The LCDB block powers the panel's +/-5.5 V (AVDD/AVEE) rails. This driver only toggles the
+ * module enable and reports VREG_OK; the output voltages are left at the PMIC power-on defaults
+ * (LDO/NCP voltage registers read 0x13 on nio), so nothing here can program an out-of-range
+ * voltage. One regulator covers both rails because they share the module enable.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#define LCDB_STS1		0x08
+#define  LCDB_STS1_VREG_OK	BIT(7)
+#define LCDB_MODULE_RDY		0x45
+#define  LCDB_MODULE_RDY_BIT	BIT(7)
+#define LCDB_ENABLE_CTL1	0x46
+#define  LCDB_MODULE_EN		BIT(7)
+
+struct lcdb {
+	struct regmap *map;
+	u32 base;
+};
+
+static int lcdb_enable(struct regulator_dev *rdev)
+{
+	struct lcdb *l = rdev_get_drvdata(rdev);
+	unsigned int sts;
+	int ret, i;
+
+	ret = regmap_update_bits(l->map, l->base + LCDB_ENABLE_CTL1, LCDB_MODULE_EN, LCDB_MODULE_EN);
+	if (ret)
+		return ret;
+	for (i = 0; i < 20; i++) {
+		usleep_range(2000, 3000);
+		ret = regmap_read(l->map, l->base + LCDB_STS1, &sts);
+		if (ret)
+			return ret;
+		if (sts & LCDB_STS1_VREG_OK)
+			return 0;
+	}
+	dev_err(&rdev->dev, "VREG_OK not set after enable (sts1=%#x)\n", sts);
+	regmap_update_bits(l->map, l->base + LCDB_ENABLE_CTL1, LCDB_MODULE_EN, 0);
+	return -ETIMEDOUT;
+}
+
+static int lcdb_disable(struct regulator_dev *rdev)
+{
+	struct lcdb *l = rdev_get_drvdata(rdev);
+
+	return regmap_update_bits(l->map, l->base + LCDB_ENABLE_CTL1, LCDB_MODULE_EN, 0);
+}
+
+static int lcdb_is_enabled(struct regulator_dev *rdev)
+{
+	struct lcdb *l = rdev_get_drvdata(rdev);
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(l->map, l->base + LCDB_ENABLE_CTL1, &val);
+	return ret ? ret : !!(val & LCDB_MODULE_EN);
+}
+
+static const struct regulator_ops lcdb_ops = {
+	.enable = lcdb_enable,
+	.disable = lcdb_disable,
+	.is_enabled = lcdb_is_enabled,
+};
+
+static const struct regulator_desc lcdb_desc = {
+	.name = "lcdb",
+	.ops = &lcdb_ops,
+	.type = REGULATOR_VOLTAGE,
+	.owner = THIS_MODULE,
+};
+
+static int lcdb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct regulator_config cfg = {};
+	struct regulator_dev *rdev;
+	unsigned int rdy;
+	struct lcdb *l;
+	int ret;
+
+	l = devm_kzalloc(dev, sizeof(*l), GFP_KERNEL);
+	if (!l)
+		return -ENOMEM;
+	l->map = dev_get_regmap(dev->parent, NULL);
+	if (!l->map)
+		return -ENODEV;
+	ret = of_property_read_u32(dev->of_node, "reg", &l->base);
+	if (ret)
+		return ret;
+	ret = regmap_read(l->map, l->base + LCDB_MODULE_RDY, &rdy);
+	if (ret)
+		return ret;
+	if (!(rdy & LCDB_MODULE_RDY_BIT))
+		return dev_err_probe(dev, -ENODEV, "LCDB module not ready (%#x)\n", rdy);
+
+	cfg.dev = dev;
+	cfg.of_node = dev->of_node;
+	cfg.driver_data = l;
+	cfg.init_data = of_get_regulator_init_data(dev, dev->of_node, &lcdb_desc);
+	rdev = devm_regulator_register(dev, &lcdb_desc, &cfg);
+	return PTR_ERR_OR_ZERO(rdev);
+}
+
+static const struct of_device_id lcdb_of_match[] = {
+	{ .compatible = "qcom,pm8150l-lcdb-switch" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, lcdb_of_match);
+
+static struct platform_driver lcdb_driver = {
+	.driver = {
+		.name = "qcom-pm8150l-lcdb",
+		.of_match_table = lcdb_of_match,
+	},
+	.probe = lcdb_probe,
+};
+module_platform_driver(lcdb_driver);
+
+MODULE_DESCRIPTION("PM8150L LCDB enable switch (mothershipOS)");
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-tianma-nt36672c-nio.c
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Tianma 6.7" 1080x2520 NT36672C DSC video-mode panel (Motorola nio, "mipi_mot_vid_tm_1080x2520_670").
+ * Init sequence, timings, DSC and power/reset sequencing are taken from the stock nio device tree
+ * (qcom,mdss_dsi_mot_tm_nt36672c_670_1080x2520_dsc_vid). mothershipOS.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct nt36672c {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[3];
+};
+
+static inline struct nt36672c *to_nt36672c(struct drm_panel *panel)
+{
+	return container_of(panel, struct nt36672c, panel);
+}
+
+static void nt36672c_init_seq(struct mipi_dsi_multi_context *ctx)
+{
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x10);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x36, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x3b, 0x03, 0x20, 0x20, 0x04, 0x04);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xc2, 0x1b, 0xa0);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0xf0);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x5a, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0xc0);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x9c, 0x11);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x9d, 0x11);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0xe0);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x35, 0x82);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x25);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x18, 0x22);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x2a);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x1d, 0x20);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x8a, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x8b, 0x20);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x98, 0x8b);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x9d, 0x4e);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x9f, 0xb2);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa3, 0x0e);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa6, 0x09);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x10);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x51, 0xcc);	/* panel-side brightness; real level is WLED */
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x53, 0x2c);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x55, 0x01);
+}
+
+static int nt36672c_prepare(struct drm_panel *panel)
+{
+	struct nt36672c *p = to_nt36672c(panel);
+	struct mipi_dsi_multi_context ctx = { .dsi = p->dsi };
+	struct drm_dsc_picture_parameter_set pps;
+	int ret;
+
+	/* stock order: vddio (+1 ms), vsp, vsn (+10 ms), then reset 1/10ms 0/1ms 1/10ms */
+	ret = regulator_enable(p->supplies[0].consumer);
+	if (ret)
+		return ret;
+	usleep_range(1000, 2000);
+	ret = regulator_enable(p->supplies[1].consumer);
+	if (ret)
+		goto err_vddio;
+	ret = regulator_enable(p->supplies[2].consumer);
+	if (ret)
+		goto err_vsp;
+	usleep_range(10000, 11000);
+
+	gpiod_set_value_cansleep(p->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(p->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(p->reset_gpio, 0);
+	usleep_range(10000, 11000);
+
+	p->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	nt36672c_init_seq(&ctx);
+
+	drm_dsc_pps_payload_pack(&pps, &p->dsc);
+	mipi_dsi_compression_mode_multi(&ctx, true);
+	mipi_dsi_picture_parameter_set_multi(&ctx, &pps);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&ctx);
+	mipi_dsi_msleep(&ctx, 101);
+	mipi_dsi_dcs_set_display_on_multi(&ctx);
+	mipi_dsi_msleep(&ctx, 41);
+	if (ctx.accum_err) {
+		ret = ctx.accum_err;
+		dev_err(&p->dsi->dev, "panel on sequence failed: %d\n", ret);
+		goto err_reset;
+	}
+	return 0;
+
+err_reset:
+	gpiod_set_value_cansleep(p->reset_gpio, 1);
+	regulator_disable(p->supplies[2].consumer);
+err_vsp:
+	regulator_disable(p->supplies[1].consumer);
+err_vddio:
+	regulator_disable(p->supplies[0].consumer);
+	return ret;
+}
+
+static int nt36672c_unprepare(struct drm_panel *panel)
+{
+	struct nt36672c *p = to_nt36672c(panel);
+	struct mipi_dsi_multi_context ctx = { .dsi = p->dsi };
+
+	p->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_set_display_off_multi(&ctx);
+	mipi_dsi_msleep(&ctx, 21);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&ctx);
+	mipi_dsi_msleep(&ctx, 71);
+
+	gpiod_set_value_cansleep(p->reset_gpio, 1);
+	regulator_disable(p->supplies[2].consumer);
+	regulator_disable(p->supplies[1].consumer);
+	usleep_range(30000, 31000);	/* stock vddio post-off 30 ms */
+	regulator_disable(p->supplies[0].consumer);
+	return 0;
+}
+
+/* stock timing@0: 90 Hz, hfp 164 hpw 12 hbp 56, vfp 32 vpw 10 vbp 22 */
+static const struct drm_display_mode nt36672c_mode = {
+	.clock = (1080 + 164 + 12 + 56) * (2520 + 32 + 10 + 22) * 90 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 164,
+	.hsync_end = 1080 + 164 + 12,
+	.htotal = 1080 + 164 + 12 + 56,
+	.vdisplay = 2520,
+	.vsync_start = 2520 + 32,
+	.vsync_end = 2520 + 32 + 10,
+	.vtotal = 2520 + 32 + 10 + 22,
+	.width_mm = 67,
+	.height_mm = 157,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int nt36672c_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &nt36672c_mode);
+}
+
+static const struct drm_panel_funcs nt36672c_funcs = {
+	.prepare = nt36672c_prepare,
+	.unprepare = nt36672c_unprepare,
+	.get_modes = nt36672c_get_modes,
+};
+
+static int nt36672c_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct nt36672c *p;
+	int ret;
+
+	p = devm_drm_panel_alloc(dev, struct nt36672c, panel, &nt36672c_funcs,
+				 DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+
+	p->supplies[0].supply = "vddio";
+	p->supplies[1].supply = "vsp";
+	p->supplies[2].supply = "vsn";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(p->supplies), p->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/* reset is active low in DT: 1 = held in reset */
+	p->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(p->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(p->reset_gpio), "failed to get reset gpio\n");
+
+	p->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, p);
+	p->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&p->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get backlight\n");
+
+	p->dsc.dsc_version_major = 1;
+	p->dsc.dsc_version_minor = 1;
+	p->dsc.slice_height = 20;
+	p->dsc.slice_width = 540;
+	p->dsc.slice_count = 1080 / p->dsc.slice_width;
+	p->dsc.bits_per_component = 8;
+	p->dsc.bits_per_pixel = 8 << 4;	/* 4 fractional bits */
+	p->dsc.block_pred_enable = true;
+	dsi->dsc = &p->dsc;
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	drm_panel_add(&p->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&p->panel);
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+	}
+	return 0;
+}
+
+static void nt36672c_remove(struct mipi_dsi_device *dsi)
+{
+	struct nt36672c *p = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&p->panel);
+}
+
+static const struct of_device_id nt36672c_of_match[] = {
+	{ .compatible = "tianma,nt36672c-nio" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, nt36672c_of_match);
+
+static struct mipi_dsi_driver nt36672c_driver = {
+	.probe = nt36672c_probe,
+	.remove = nt36672c_remove,
+	.driver = {
+		.name = "panel-tianma-nt36672c-nio",
+		.of_match_table = nt36672c_of_match,
+	},
+};
+module_mipi_dsi_driver(nt36672c_driver);
+
+MODULE_DESCRIPTION("Tianma NT36672C 1080x2520 DSC panel (Motorola nio)");
+MODULE_LICENSE("GPL");
