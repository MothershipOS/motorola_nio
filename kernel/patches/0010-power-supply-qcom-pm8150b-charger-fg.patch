+/* ------------------------------------------------------------------ battery psy */
+static const enum power_supply_property batt_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CAPACITY_LEVEL,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_POWER_NOW,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD,
+	POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD,
+	POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+	POWER_SUPPLY_PROP_SCOPE,
+};
+
+static int batt_full_uah(struct pm8150b_chg *c)
+{
+	int uah;
+
+	if (!fg_cap_word(c, SRAM_ACT_BATT_CAP_WORD, &uah))
+		return uah;
+	return c->design_uah;
+}
+
+static int batt_get(struct power_supply *psy, enum power_supply_property psp, union power_supply_propval *val)
+{
+	struct pm8150b_chg *c = power_supply_get_drvdata(psy);
+	int rc = 0, uv, ua, soc;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = chg_status(c);
+		if (val->intval == POWER_SUPPLY_STATUS_NOT_CHARGING && !fg_capacity(c, &soc) && soc >= 100)
+			val->intval = POWER_SUPPLY_STATUS_FULL;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		val->intval = batt_health(c);
+		if (val->intval == POWER_SUPPLY_HEALTH_GOOD && c->temp_valid && c->zone >= c->nzones)
+			val->intval = POWER_SUPPLY_HEALTH_OVERHEAT;
+		else if (val->intval == POWER_SUPPLY_HEALTH_GOOD && c->temp_valid && c->zone == -1)
+			val->intval = POWER_SUPPLY_HEALTH_COLD;
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		rc = fg_capacity(c, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY_LEVEL:
+		rc = fg_capacity(c, &soc);
+		val->intval = soc >= 100 ? POWER_SUPPLY_CAPACITY_LEVEL_FULL :
+			      soc >= 80 ? POWER_SUPPLY_CAPACITY_LEVEL_HIGH :
+			      soc > 15 ? POWER_SUPPLY_CAPACITY_LEVEL_NORMAL :
+			      soc > 5 ? POWER_SUPPLY_CAPACITY_LEVEL_LOW : POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		rc = fg_vbat_ibat(c, &val->intval, NULL);
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		rc = fg_vbat_ibat(c, NULL, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_POWER_NOW:
+		rc = fg_vbat_ibat(c, &uv, &ua);
+		val->intval = div_s64((s64)uv * ua, 1000000);
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		rc = fg_temp(c, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = c->design_uah;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+		val->intval = batt_full_uah(c);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		rc = fg_capacity(c, &soc);
+		val->intval = div_u64((u64)batt_full_uah(c) * soc, 100);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = c->design_uv_max;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		val->intval = c->start_threshold;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		val->intval = c->end_threshold;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		val->intval = c->force_discharge ? POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE :
+			      c->inhibit ? POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE :
+					   POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
+		break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "Motorola LZ50 5000 mAh";
+		break;
+	case POWER_SUPPLY_PROP_SCOPE:
+		val->intval = POWER_SUPPLY_SCOPE_SYSTEM;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return rc;
+}
+
+static int batt_set(struct power_supply *psy, enum power_supply_property psp,
+		    const union power_supply_propval *val)
+{
+	struct pm8150b_chg *c = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		if (val->intval < 20 || val->intval > 100)
+			return -EINVAL;
+		c->end_threshold = val->intval;
+		c->start_threshold = min(c->start_threshold, c->end_threshold - 5);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		if (val->intval < 0 || val->intval > c->end_threshold - 5)
+			return -EINVAL;
+		c->start_threshold = val->intval;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		if (val->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
+		    val->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE &&
+		    val->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE)
+			return -EINVAL;
+		c->inhibit = val->intval == POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+		c->force_discharge = val->intval == POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE;
+		break;
+	default:
+		return -EINVAL;
+	}
+	pm8150b_kick(c, 0);
+	return 0;
+}
+
+static int batt_writeable(struct power_supply *psy, enum power_supply_property psp)
+{
+	return psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD ||
+	       psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD ||
+	       psp == POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR;
+}
+
+static const struct power_supply_desc batt_desc = {
+	.name = "battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = batt_props,
+	.num_properties = ARRAY_SIZE(batt_props),
+	.charge_behaviours = BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO) |
+			     BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE) |
+			     BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE),
+	.get_property = batt_get,
+	.set_property = batt_set,
+	.property_is_writeable = batt_writeable,
+};
+
+/* ------------------------------------------------------------------ setup */
+static irqreturn_t pm8150b_irq(int irq, void *data)
+{
+	struct pm8150b_chg *c = data;
+
+	/* plug/unplug, APSD result, ICL or charger state change: re-evaluate soon (APSD needs ~1 s) */
+	pm8150b_kick(c, irq == c->plugin_irq ? 1500 : 100);
+	power_supply_changed(c->usb_psy);
+	return IRQ_HANDLED;
+}
+
+static int pm8150b_parse_zones(struct pm8150b_chg *c)
+{
+	struct device_node *np = c->dev->of_node;
+	int i, n = of_property_count_u32_elems(np, "mmi,temp-zones");
+	u32 v[4];
+
+	if (n <= 0 || n % 4)
+		return dev_err_probe(c->dev, -EINVAL, "mmi,temp-zones: <temp_C norm_mV fcc_max_mA fcc_norm_mA>...\n");
+	c->nzones = n / 4;
+	c->zones = devm_kcalloc(c->dev, c->nzones, sizeof(*c->zones), GFP_KERNEL);
+	if (!c->zones)
+		return -ENOMEM;
+	for (i = 0; i < c->nzones; i++) {
+		of_property_read_u32_index(np, "mmi,temp-zones", i * 4, &v[0]);
+		of_property_read_u32_index(np, "mmi,temp-zones", i * 4 + 1, &v[1]);
+		of_property_read_u32_index(np, "mmi,temp-zones", i * 4 + 2, &v[2]);
+		of_property_read_u32_index(np, "mmi,temp-zones", i * 4 + 3, &v[3]);
+		c->zones[i] = (struct mmi_zone){ (s32)v[0] * 10, v[1], v[2] * 1000, v[3] * 1000 };
+		if (c->zones[i].fcc_max_ua > c->fcc_max_ua || c->zones[i].fcc_norm_ua > c->fcc_max_ua)
+			return dev_err_probe(c->dev, -EINVAL, "zone %d above the battery's FCC max\n", i);
+	}
+	return 0;
+}
+
+static int pm8150b_init_hw(struct pm8150b_chg *c)
+{
+	s16 raw;
+	u8 buf[2];
+	int rc;
+
+	/* AICL with periodic rerun (backs the ICL off on weak adapters / cables) */
+	rc = regmap_update_bits(c->regmap, USBIN_AICL_OPTIONS_CFG,
+				USBIN_AICL_PERIODIC_RERUN_EN_BIT | USBIN_AICL_EN_BIT,
+				USBIN_AICL_PERIODIC_RERUN_EN_BIT | USBIN_AICL_EN_BIT);
+	if (rc)
+		return rc;
+	/* termination current (ADC based): raw = -iterm * 32767 / 10000, big endian */
+	raw = -(s16)div_s64((s64)c->iterm_ma * 32767, ITERM_LIMIT_MA);
+	buf[0] = (u16)raw >> 8;
+	buf[1] = (u16)raw & 0xff;
+	rc = regmap_bulk_write(c->regmap, CHGR_ADC_ITERM_UP_THD_MSB, buf, 2);
+	if (rc)
+		return rc;
+	/* DMA addressing by partition for FG SRAM reads */
+	rc = regmap_update_bits(c->regmap, MEM_IF_DMA_CTL, ADDR_KIND_BIT, ADDR_KIND_BIT);
+	if (rc)
+		return rc;
+	return set_fv(c, c->fv_uv);
+}
+
+static int pm8150b_probe(struct platform_device *pdev)
+{
+	static const char * const irqs[] = { "usb-plugin", "usb-source-change", "usbin-icl-change",
+					     "chg-state-change" };
+	struct power_supply_config cfg = {};
+	struct device *dev = &pdev->dev;
+	struct pm8150b_chg *c;
+	int i, irq, rc;
+
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	c->dev = dev;
+	mutex_init(&c->lock);
+	c->regmap = dev_get_regmap(dev->parent, NULL);
+	if (!c->regmap)
+		return dev_err_probe(dev, -ENODEV, "no regmap\n");
+
+	c->fcc_max_ua = 1000000;
+	c->fv_uv = 4200000;
+	c->icl_max_ua = 3000000;
+	c->iterm_ma = 150;
+	c->design_uah = 0;
+	of_property_read_u32(dev->of_node, "constant-charge-current-max-microamp", &c->fcc_max_ua);
+	of_property_read_u32(dev->of_node, "constant-charge-voltage-max-microvolt", &c->fv_uv);
+	of_property_read_u32(dev->of_node, "input-current-limit-max-microamp", &c->icl_max_ua);
+	of_property_read_u32(dev->of_node, "charge-term-current-milliamp", &c->iterm_ma);
+	of_property_read_u32(dev->of_node, "charge-full-design-microamp-hours", &c->design_uah);
+	c->design_uv_max = c->fv_uv;
+	if (c->fv_uv > 4450000 || c->fcc_max_ua > 6000000)
+		return dev_err_probe(dev, -EINVAL, "charge limits out of range\n");
+	rc = pm8150b_parse_zones(c);
+	if (rc)
+		return rc;
+
+	c->zone = INT_MIN;
+	c->fcc_ua = -1;
+	c->icl_ua = -1;
+	c->user_fcc_ua = c->fcc_max_ua;
+	c->user_icl_ua = c->icl_max_ua;
+	c->end_threshold = 100;
+	c->start_threshold = 95;
+
+	c->usb_in_v = devm_iio_channel_get(dev, "usb_in_v");
+	if (IS_ERR(c->usb_in_v)) {
+		if (PTR_ERR(c->usb_in_v) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		c->usb_in_v = NULL;
+	}
+	c->usb_in_i = devm_iio_channel_get(dev, "usb_in_i");
+	if (IS_ERR(c->usb_in_i)) {
+		if (PTR_ERR(c->usb_in_i) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		c->usb_in_i = NULL;
+	}
+
+	rc = pm8150b_init_hw(c);
+	if (rc)
+		return dev_err_probe(dev, rc, "hw init\n");
+
+	cfg.drv_data = c;
+	cfg.fwnode = dev_fwnode(dev);
+	c->usb_psy = devm_power_supply_register(dev, &usb_desc, &cfg);
+	if (IS_ERR(c->usb_psy))
+		return dev_err_probe(dev, PTR_ERR(c->usb_psy), "usb psy\n");
+	cfg.fwnode = NULL;
+	c->batt_psy = devm_power_supply_register(dev, &batt_desc, &cfg);
+	if (IS_ERR(c->batt_psy))
+		return dev_err_probe(dev, PTR_ERR(c->batt_psy), "battery psy\n");
+
+	rc = devm_delayed_work_autocancel(dev, &c->work, pm8150b_work);
+	if (rc)
+		return rc;
+
+	for (i = 0; i < ARRAY_SIZE(irqs); i++) {
+		irq = platform_get_irq_byname(pdev, irqs[i]);
+		if (irq < 0)
+			return irq;
+		rc = devm_request_threaded_irq(dev, irq, NULL, pm8150b_irq, IRQF_ONESHOT, irqs[i], c);
+		if (rc)
+			return dev_err_probe(dev, rc, "irq %s\n", irqs[i]);
+		if (i == 0)
+			c->plugin_irq = irq;
+	}
+	devm_device_init_wakeup(dev);
+	rc = devm_pm_set_wake_irq(dev, c->plugin_irq);
+	if (rc)
+		return rc;
+
+	platform_set_drvdata(pdev, c);
+	schedule_delayed_work(&c->work, 0);
+	dev_info(dev, "PM8150B charger + FG: FCC max %u mA, FV %u mV, ICL max %u mA, %d temperature zones\n",
+		 c->fcc_max_ua / 1000, c->fv_uv / 1000, c->icl_max_ua / 1000, c->nzones);
+	return 0;
+}
+
+static int pm8150b_resume(struct device *dev)
+{
+	struct pm8150b_chg *c = dev_get_drvdata(dev);
+
+	pm8150b_kick(c, 0);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(pm8150b_pm, NULL, pm8150b_resume);
+
+static const struct of_device_id pm8150b_match[] = {
+	{ .compatible = "qcom,pm8150b-charger-fg" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, pm8150b_match);
+
+static struct platform_driver pm8150b_driver = {
+	.probe = pm8150b_probe,
+	.driver = {
+		.name = "qcom-pm8150b-charger",
+		.of_match_table = pm8150b_match,
+		.pm = pm_sleep_ptr(&pm8150b_pm),
+	},
+};
+module_platform_driver(pm8150b_driver);
+
+MODULE_DESCRIPTION("Qualcomm PM8150B SMB5 charger and FG gen4 fuel gauge");
+MODULE_LICENSE("GPL");
