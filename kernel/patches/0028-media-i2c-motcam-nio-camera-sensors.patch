mothershipOS camera: one table-driven driver (motcam) for the nio's other four sensors: ultrawide OV16A10, front
OV16A1Q, depth OV02B1B (mono, 1 lane, paged 8-bit registers) and front ultrawide S5K4H7 (SMIA). Register tables,
exposure / gain / frame length registers, stream sequences, power order and CSI-2 timing from the stock Qualcomm
sensor modules (archive/prototypes/camera/chromatix.py); every stock mode, selected with set_fmt.

---
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -583,6 +583,14 @@
 	  To compile this driver as a module, choose M here: the
 	  module will be called ov6211.
 
+config VIDEO_MOTCAM
+	tristate "Motorola nio camera sensors (OV16A10, OV16A1Q, OV02B1B, S5K4H7)"
+	depends on OF && I2C
+	select V4L2_CCI_I2C
+	help
+	  The Motorola nio's ultrawide (OV16A10), front (OV16A1Q), depth (OV02B1B) and front ultrawide (S5K4H7)
+	  camera sensors, from the register tables of the stock sensor modules.
+
 config VIDEO_OV64B
 	tristate "OmniVision OV64B sensor support"
 	depends on OF && I2C
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -107,6 +107,7 @@
 obj-$(CONFIG_VIDEO_OV5693) += ov5693.o
 obj-$(CONFIG_VIDEO_OV5695) += ov5695.o
 obj-$(CONFIG_VIDEO_OV6211) += ov6211.o
+obj-$(CONFIG_VIDEO_MOTCAM) += motcam.o
 obj-$(CONFIG_VIDEO_OV64B) += ov64b.o
 obj-$(CONFIG_VIDEO_OV64A40) += ov64a40.o
 obj-$(CONFIG_VIDEO_OV7251) += ov7251.o
diff --git a/drivers/media/i2c/motcam.c b/drivers/media/i2c/motcam.c
new file mode 100644
--- /dev/null
+++ b/drivers/media/i2c/motcam.c
@@ -0,0 +1,648 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The Motorola nio's other camera sensors (ultrawide OV16A10, front OV16A1Q, depth OV02B1B, front ultrawide
+ * S5K4H7): one table-driven driver. mothershipOS.
+ *
+ * Everything sensor specific comes from the stock Qualcomm sensor modules (com.qti.sensormodule.mot_nio_*.bin,
+ * decoded with archive/prototypes/camera/chromatix.py): the init and mode register tables (motcam_regs.h), the
+ * exposure / gain / frame length registers, the stream sequences, power order and CSI-2 timing. The gain codes
+ * follow each family's convention (OmniVision 0x3508: real * 256; SMIA 0x0204: real * 32; OV02B1B 0x22:
+ * real * 16); the modules carry no formula for them.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#include "motcam_regs.h"
+
+#define MOTCAM_MCLK_HZ		24000000
+#define MOTCAM_MAX_SUPPLIES	3
+#define MOTCAM_MAX_LINK_FREQS	4
+#define MOTCAM_VTS_MAX		0xffff
+
+struct motcam_mode {
+	u32 width, height;
+	/* frame length (lines) and line length (pixels at pixel_rate) */
+	u32 vts, hts;
+	s64 link_freq;
+	u64 pixel_rate;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+#define MODE(w, h, v, l, opclk, lanes, r) { w, h, v, l, (opclk) * 10ULL / (2 * (lanes)), opclk, r, ARRAY_SIZE(r) }
+
+struct motcam_data {
+	const char *name;
+	/* the subdev's name: the sensor model, as libcamera and media-ctl identify it */
+	const char *model;
+	u32 code;
+	unsigned int lanes;
+	u32 native_width, native_height;
+	unsigned int addr_bits;
+	u32 id_reg;
+	u64 id;
+	/* the init table's first entries are a soft reset: wait reset_us after them */
+	const struct cci_reg_sequence *init;
+	unsigned int num_init, reset_regs, reset_us;
+	const struct cci_reg_sequence *stream_on, *stream_off;
+	unsigned int num_stream_on, num_stream_off;
+	/* control registers, written between pre and post (a register page, a latch) */
+	u32 reg_exposure, reg_gain, reg_vts;
+	const struct cci_reg_sequence *ctrl_pre, *ctrl_post;
+	unsigned int num_ctrl_pre, num_ctrl_post;
+	u32 exposure_min, exposure_margin;
+	u32 gain_min, gain_max;
+	/* stock power order: MCLK, reset, supplies (in this order), then the waits below */
+	const char * const *supplies;
+	unsigned int num_supplies, supplies_us, reset_us_after;
+	const struct motcam_mode *modes;
+	unsigned int num_modes;
+};
+
+struct motcam {
+	struct device *dev;
+	const struct motcam_data *d;
+	struct regmap *cci;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct clk *mclk;
+	struct gpio_desc *reset;
+	struct regulator_bulk_data supplies[MOTCAM_MAX_SUPPLIES];
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *link_freq, *pixel_rate, *hblank, *vblank, *exposure;
+	s64 link_freqs[MOTCAM_MAX_LINK_FREQS];
+	unsigned int num_link_freqs;
+	const struct motcam_mode *mode;
+};
+
+static inline struct motcam *to_motcam(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct motcam, sd);
+}
+
+/* ---- power ---- */
+
+static int motcam_power_on(struct device *dev)
+{
+	struct motcam *s = to_motcam(dev_get_drvdata(dev));
+	int ret;
+
+	ret = clk_prepare_enable(s->mclk);
+	if (ret)
+		return ret;
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(s->reset, 1);
+	usleep_range(1000, 1500);
+	ret = regulator_bulk_enable(s->d->num_supplies, s->supplies);
+	if (ret) {
+		clk_disable_unprepare(s->mclk);
+		return ret;
+	}
+	fsleep(s->d->supplies_us);
+	gpiod_set_value_cansleep(s->reset, 0);
+	fsleep(s->d->reset_us_after + 4000);	/* margin before the first register access */
+	return 0;
+}
+
+static int motcam_power_off(struct device *dev)
+{
+	struct motcam *s = to_motcam(dev_get_drvdata(dev));
+
+	clk_disable_unprepare(s->mclk);
+	gpiod_set_value_cansleep(s->reset, 1);
+	regulator_bulk_disable(s->d->num_supplies, s->supplies);
+	return 0;
+}
+
+/* ---- controls ---- */
+
+static void motcam_update_ranges(struct motcam *s)
+{
+	const struct motcam_mode *m = s->mode;
+	unsigned int i;
+
+	for (i = 0; i < s->num_link_freqs; i++)
+		if (s->link_freqs[i] == m->link_freq)
+			__v4l2_ctrl_s_ctrl(s->link_freq, i);
+	__v4l2_ctrl_modify_range(s->pixel_rate, m->pixel_rate, m->pixel_rate, 1, m->pixel_rate);
+	__v4l2_ctrl_modify_range(s->hblank, m->hts - m->width, m->hts - m->width, 1, m->hts - m->width);
+	if (s->d->reg_vts)
+		__v4l2_ctrl_modify_range(s->vblank, m->vts - m->height, MOTCAM_VTS_MAX - m->height, 1,
+					 m->vts - m->height);
+	else
+		__v4l2_ctrl_modify_range(s->vblank, m->vts - m->height, m->vts - m->height, 1,
+					 m->vts - m->height);
+	__v4l2_ctrl_modify_range(s->exposure, s->d->exposure_min, m->vts - s->d->exposure_margin, 1,
+				 m->vts - s->d->exposure_margin);
+}
+
+static int motcam_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct motcam *s = container_of(ctrl->handler, struct motcam, ctrls);
+	const struct motcam_data *d = s->d;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int exp_max = s->mode->height + ctrl->val - d->exposure_margin;
+
+		__v4l2_ctrl_modify_range(s->exposure, s->exposure->minimum, exp_max, 1,
+					 min(s->exposure->val, exp_max));
+	}
+
+	if (!pm_runtime_get_if_active(s->dev))
+		return 0;
+
+	if (d->ctrl_pre)
+		cci_multi_reg_write(s->cci, d->ctrl_pre, d->num_ctrl_pre, &ret);
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(s->cci, d->reg_exposure, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(s->cci, d->reg_gain, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		if (d->reg_vts)
+			cci_write(s->cci, d->reg_vts, s->mode->height + ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	if (d->ctrl_post)
+		cci_multi_reg_write(s->cci, d->ctrl_post, d->num_ctrl_post, &ret);
+
+	pm_runtime_put(s->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops motcam_ctrl_ops = {
+	.s_ctrl = motcam_set_ctrl,
+};
+
+static int motcam_init_controls(struct motcam *s)
+{
+	const struct motcam_data *d = s->d;
+	const struct motcam_mode *m = s->mode;
+	struct v4l2_ctrl_handler *h = &s->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	unsigned int i, j;
+	int ret;
+
+	for (i = 0; i < d->num_modes; i++) {
+		for (j = 0; j < s->num_link_freqs && s->link_freqs[j] != d->modes[i].link_freq; j++)
+			;
+		if (j == s->num_link_freqs && s->num_link_freqs < MOTCAM_MAX_LINK_FREQS)
+			s->link_freqs[s->num_link_freqs++] = d->modes[i].link_freq;
+	}
+
+	v4l2_ctrl_handler_init(h, 10);
+	s->link_freq = v4l2_ctrl_new_int_menu(h, NULL, V4L2_CID_LINK_FREQ, s->num_link_freqs - 1, 0,
+					      s->link_freqs);
+	if (s->link_freq)
+		s->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	s->pixel_rate = v4l2_ctrl_new_std(h, NULL, V4L2_CID_PIXEL_RATE, m->pixel_rate, m->pixel_rate, 1,
+					  m->pixel_rate);
+	s->hblank = v4l2_ctrl_new_std(h, NULL, V4L2_CID_HBLANK, m->hts - m->width, m->hts - m->width, 1,
+				      m->hts - m->width);
+	if (s->hblank)
+		s->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	s->vblank = v4l2_ctrl_new_std(h, &motcam_ctrl_ops, V4L2_CID_VBLANK, m->vts - m->height,
+				      d->reg_vts ? MOTCAM_VTS_MAX - m->height : m->vts - m->height, 1,
+				      m->vts - m->height);
+	s->exposure = v4l2_ctrl_new_std(h, &motcam_ctrl_ops, V4L2_CID_EXPOSURE, d->exposure_min,
+					m->vts - d->exposure_margin, 1, m->vts - d->exposure_margin);
+	v4l2_ctrl_new_std(h, &motcam_ctrl_ops, V4L2_CID_ANALOGUE_GAIN, d->gain_min, d->gain_max, 1,
+			  d->gain_min);
+
+	ret = v4l2_fwnode_device_parse(s->dev, &props);
+	if (ret)
+		goto err;
+	v4l2_ctrl_new_fwnode_properties(h, &motcam_ctrl_ops, &props);
+	if (h->error) {
+		ret = h->error;
+		goto err;
+	}
+	/* the ranges are mode 0's (s->mode) already */
+	s->sd.ctrl_handler = h;
+	return 0;
+err:
+	v4l2_ctrl_handler_free(h);
+	return ret;
+}
+
+/* ---- streaming ---- */
+
+static int motcam_start(struct motcam *s)
+{
+	const struct motcam_data *d = s->d;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_multi_reg_write(s->cci, d->init, d->reset_regs, NULL);
+	if (d->reset_us)
+		fsleep(d->reset_us);
+	ret = ret ?: cci_multi_reg_write(s->cci, d->init + d->reset_regs, d->num_init - d->reset_regs, NULL);
+	ret = ret ?: cci_multi_reg_write(s->cci, s->mode->regs, s->mode->num_regs, NULL);
+	ret = ret ?: __v4l2_ctrl_handler_setup(&s->ctrls);
+	ret = ret ?: cci_multi_reg_write(s->cci, d->stream_on, d->num_stream_on, NULL);
+	if (ret) {
+		dev_err(s->dev, "stream on failed: %d\n", ret);
+		pm_runtime_put(s->dev);
+	}
+	return ret;
+}
+
+static void motcam_stop(struct motcam *s)
+{
+	cci_multi_reg_write(s->cci, s->d->stream_off, s->d->num_stream_off, NULL);
+	pm_runtime_put(s->dev);
+}
+
+static int motcam_enable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	return motcam_start(to_motcam(sd));
+}
+
+static int motcam_disable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	motcam_stop(to_motcam(sd));
+	return 0;
+}
+
+/* ---- pad ops ---- */
+
+static void motcam_fill_fmt(const struct motcam_data *d, const struct motcam_mode *m, struct v4l2_mbus_framefmt *f)
+{
+	f->width = m->width;
+	f->height = m->height;
+	f->code = d->code;
+	f->field = V4L2_FIELD_NONE;
+	f->colorspace = V4L2_COLORSPACE_RAW;
+	f->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	f->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	f->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int motcam_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = to_motcam(sd)->d->code;
+	return 0;
+}
+
+static int motcam_enum_frame_size(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	const struct motcam_data *d = to_motcam(sd)->d;
+
+	if (fse->index >= d->num_modes || fse->code != d->code)
+		return -EINVAL;
+	fse->min_width = fse->max_width = d->modes[fse->index].width;
+	fse->min_height = fse->max_height = d->modes[fse->index].height;
+	return 0;
+}
+
+static int motcam_set_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct motcam *s = to_motcam(sd);
+	const struct motcam_mode *m;
+
+	m = v4l2_find_nearest_size(s->d->modes, s->d->num_modes, width, height, fmt->format.width,
+				   fmt->format.height);
+	motcam_fill_fmt(s->d, m, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE && m != s->mode) {
+		s->mode = m;
+		motcam_update_ranges(s);
+	}
+	return 0;
+}
+
+static int motcam_get_selection(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	const struct motcam_data *d = to_motcam(sd)->d;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r = (struct v4l2_rect){ 0, 0, d->native_width, d->native_height };
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int motcam_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	struct motcam *s = to_motcam(sd);
+
+	motcam_fill_fmt(s->d, s->mode, v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops motcam_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops motcam_pad_ops = {
+	.enum_mbus_code = motcam_enum_mbus_code,
+	.enum_frame_size = motcam_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = motcam_set_fmt,
+	.get_selection = motcam_get_selection,
+	.enable_streams = motcam_enable_streams,
+	.disable_streams = motcam_disable_streams,
+};
+
+static const struct v4l2_subdev_ops motcam_subdev_ops = {
+	.video = &motcam_video_ops,
+	.pad = &motcam_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops motcam_internal_ops = {
+	.init_state = motcam_init_state,
+};
+
+/* ---- the sensors ---- */
+
+static const char * const motcam_avdd_dvdd_dovdd[] = { "avdd", "dvdd", "dovdd" };	/* stock VANA, VDIG, VIO */
+static const char * const motcam_avdd_dovdd[] = { "avdd", "dovdd" };
+
+static const struct cci_reg_sequence ov16a_stream_on[] = { { CCI_REG8(0x0100), 0x01 } };
+static const struct cci_reg_sequence ov16a_stream_off[] = { { CCI_REG8(0x0100), 0x00 } };
+
+/* stock modes 0 (full) and 1 (1080p, 2x2 binned) */
+static const struct motcam_mode ov16a10_modes[] = {
+	MODE(4608, 3456, 3920, 5347, 628800000ULL, 4, ov16a10_mode0_regs),
+	MODE(1920, 1080, 1960, 2449, 288000000ULL, 4, ov16a10_mode1_regs),
+};
+
+static const struct motcam_data ov16a10_data = {
+	.name = "OV16A10", .model = "ov16a10", .code = MEDIA_BUS_FMT_SBGGR10_1X10, .lanes = 4,
+	.native_width = 4608, .native_height = 3456,
+	.addr_bits = 16, .id_reg = CCI_REG16(0x300b), .id = 0x1641,
+	.init = ov16a10_init_regs, .num_init = ARRAY_SIZE(ov16a10_init_regs), .reset_regs = 1, .reset_us = 5000,
+	.stream_on = ov16a_stream_on, .num_stream_on = 1, .stream_off = ov16a_stream_off, .num_stream_off = 1,
+	.reg_exposure = CCI_REG24(0x3500), .reg_gain = CCI_REG16(0x3508), .reg_vts = CCI_REG16(0x380e),
+	.exposure_min = 8, .exposure_margin = 16, .gain_min = 0x100, .gain_max = 0xf80,
+	.supplies = motcam_avdd_dvdd_dovdd, .num_supplies = 3, .supplies_us = 1000, .reset_us_after = 4000,
+	.modes = ov16a10_modes, .num_modes = ARRAY_SIZE(ov16a10_modes),
+};
+
+/* stock modes 0 (full), 1 (2x2 binned), 2 (1080p 120 fps), 3 (720p 240 fps) */
+static const struct motcam_mode ov16a1q_modes[] = {
+	MODE(4608, 3456, 3920, 5046, 593600000ULL, 4, ov16a1q_mode0_regs),
+	MODE(2304, 1728, 3920, 2523, 296800000ULL, 4, ov16a1q_mode1_regs),
+	MODE(1920, 1080, 1114, 4440, 593600000ULL, 4, ov16a1q_mode2_regs),
+	MODE(1280, 720, 980, 2523, 593600000ULL, 4, ov16a1q_mode3_regs),
+};
+
+static const struct motcam_data ov16a1q_data = {
+	.name = "OV16A1Q", .model = "ov16a1q", .code = MEDIA_BUS_FMT_SBGGR10_1X10, .lanes = 4,
+	.native_width = 4608, .native_height = 3456,
+	.addr_bits = 16, .id_reg = CCI_REG16(0x300b), .id = 0x1641,
+	.init = ov16a1q_init_regs, .num_init = ARRAY_SIZE(ov16a1q_init_regs), .reset_regs = 1, .reset_us = 5000,
+	.stream_on = ov16a_stream_on, .num_stream_on = 1, .stream_off = ov16a_stream_off, .num_stream_off = 1,
+	.reg_exposure = CCI_REG24(0x3500), .reg_gain = CCI_REG16(0x3508), .reg_vts = CCI_REG16(0x380e),
+	.exposure_min = 8, .exposure_margin = 16, .gain_min = 0x100, .gain_max = 0xf80,
+	.supplies = motcam_avdd_dvdd_dovdd, .num_supplies = 3, .supplies_us = 1000, .reset_us_after = 4000,
+	.modes = ov16a1q_modes, .num_modes = ARRAY_SIZE(ov16a1q_modes),
+};
+
+/* OV02B1B: 8-bit registers in pages (0xfd); page 1 holds exposure and gain, 0xfe = 2 latches them */
+static const struct cci_reg_sequence ov02b1b_stream_on[] = {
+	{ CCI_REG8(0xfd), 0x01 }, { CCI_REG8(0x10), 0x00 }, { CCI_REG8(0xfd), 0x03 }, { CCI_REG8(0xc2), 0x01 },
+};
+static const struct cci_reg_sequence ov02b1b_stream_off[] = {
+	{ CCI_REG8(0xfd), 0x01 }, { CCI_REG8(0x10), 0x01 }, { CCI_REG8(0xfd), 0x03 }, { CCI_REG8(0xc2), 0x00 },
+};
+static const struct cci_reg_sequence ov02b1b_page1[] = { { CCI_REG8(0xfd), 0x01 } };
+static const struct cci_reg_sequence ov02b1b_latch[] = { { CCI_REG8(0xfe), 0x02 } };
+
