+/* ---- probe ---- */
+
+static int motcam_check_endpoint(struct motcam *s)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *epn;
+	unsigned int i, j;
+	int ret;
+
+	epn = fwnode_graph_get_next_endpoint(dev_fwnode(s->dev), NULL);
+	if (!epn)
+		return dev_err_probe(s->dev, -ENXIO, "no endpoint\n");
+	ret = v4l2_fwnode_endpoint_alloc_parse(epn, &ep);
+	fwnode_handle_put(epn);
+	if (ret)
+		return dev_err_probe(s->dev, ret, "endpoint parse\n");
+	if (ep.bus.mipi_csi2.num_data_lanes != s->d->lanes)
+		ret = dev_err_probe(s->dev, -EINVAL, "need %u data lanes\n", s->d->lanes);
+	/* every mode's link frequency must be allowed by the board */
+	for (i = 0; !ret && i < s->d->num_modes; i++) {
+		for (j = 0; j < ep.nr_of_link_frequencies && ep.link_frequencies[j] != s->d->modes[i].link_freq; j++)
+			;
+		if (j == ep.nr_of_link_frequencies)
+			ret = dev_err_probe(s->dev, -EINVAL, "link-frequencies lacks %lld\n",
+					    s->d->modes[i].link_freq);
+	}
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int motcam_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct motcam *s;
+	u64 id;
+	unsigned int i;
+	int ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	s->dev = dev;
+	s->d = of_device_get_match_data(dev);
+	s->mode = &s->d->modes[0];
+
+	ret = motcam_check_endpoint(s);
+	if (ret)
+		return ret;
+
+	s->cci = devm_cci_regmap_init_i2c(client, s->d->addr_bits);
+	if (IS_ERR(s->cci))
+		return PTR_ERR(s->cci);
+
+	for (i = 0; i < s->d->num_supplies; i++)
+		s->supplies[i].supply = s->d->supplies[i];
+	ret = devm_regulator_bulk_get(dev, s->d->num_supplies, s->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "supplies\n");
+	s->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s->reset))
+		return dev_err_probe(dev, PTR_ERR(s->reset), "reset gpio\n");
+	s->mclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(s->mclk))
+		return dev_err_probe(dev, PTR_ERR(s->mclk), "mclk\n");
+	ret = clk_set_rate(s->mclk, MOTCAM_MCLK_HZ);
+	if (ret)
+		return dev_err_probe(dev, ret, "mclk rate\n");
+
+	v4l2_i2c_subdev_init(&s->sd, client, &motcam_subdev_ops);
+	s->sd.internal_ops = &motcam_internal_ops;
+	snprintf(s->sd.name, sizeof(s->sd.name), "%s %d-%04x", s->d->model, i2c_adapter_id(client->adapter),
+		 client->addr);
+
+	ret = motcam_power_on(dev);
+	if (ret)
+		return ret;
+	/* a paged sensor reads its id on page 0 */
+	if (s->d->ctrl_pre)
+		cci_write(s->cci, CCI_REG8(0xfd), 0x00, NULL);
+	ret = cci_read(s->cci, s->d->id_reg, &id, NULL);
+	if (ret || id != s->d->id) {
+		ret = dev_err_probe(dev, ret ?: -ENODEV, "%s: chip id %#llx\n", s->d->name, id);
+		goto err_power;
+	}
+	dev_info(dev, "%s at %#x\n", s->d->name, client->addr);
+
+	ret = motcam_init_controls(s);
+	if (ret)
+		goto err_power;
+
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (ret)
+		goto err_ctrls;
+	s->sd.state_lock = s->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&s->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s->sd);
+	if (ret)
+		goto err_pm;
+
+	pm_runtime_idle(dev);
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&s->sd);
+err_entity:
+	media_entity_cleanup(&s->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&s->ctrls);
+err_power:
+	motcam_power_off(dev);
+	return ret;
+}
+
+static void motcam_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct motcam *s = to_motcam(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s->ctrls);
+	pm_runtime_disable(s->dev);
+	if (!pm_runtime_status_suspended(s->dev))
+		motcam_power_off(s->dev);
+	pm_runtime_set_suspended(s->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(motcam_pm_ops, motcam_power_off, motcam_power_on, NULL);
+
+static const struct of_device_id motcam_of_match[] = {
+	{ .compatible = "ovti,ov16a10", .data = &ov16a10_data },
+	{ .compatible = "ovti,ov16a1q", .data = &ov16a1q_data },
+	{ .compatible = "ovti,ov02b1b", .data = &ov02b1b_data },
+	{ .compatible = "samsung,s5k4h7", .data = &s5k4h7_data },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, motcam_of_match);
+
+static struct i2c_driver motcam_driver = {
+	.driver = {
+		.name = "motcam",
+		.of_match_table = motcam_of_match,
+		.pm = pm_ptr(&motcam_pm_ops),
+	},
+	.probe = motcam_probe,
+	.remove = motcam_remove,
+};
+module_i2c_driver(motcam_driver);
+
+MODULE_DESCRIPTION("Motorola nio camera sensors: OV16A10, OV16A1Q, OV02B1B, S5K4H7");
+MODULE_LICENSE("GPL");
