+		dev_err(__scm->dev, "pas_init_image(%u) ret=%d tz_result=%#llx mdata=%pa own_shmbridge=%d\n",
+			pas_id, ret, (u64)res.result[0], &mdata_phys, qcom_scm_pil_own_shmbridge());
 	if (ret < 0 || !ctx) {
-		dma_free_coherent(__scm->dev, size, mdata_buf, mdata_phys);
+		if (qcom_scm_pil_own_shmbridge())
+			qcom_tzmem_free(mdata_buf);
+		else
+			dma_free_coherent(__scm->dev, size, mdata_buf, mdata_phys);
 	} else if (ctx) {
 		ctx->ptr = mdata_buf;
 		ctx->phys = mdata_phys;
@@ -691,7 +744,10 @@
 	if (!ctx->ptr)
 		return;
 
-	dma_free_coherent(__scm->dev, ctx->size, ctx->ptr, ctx->phys);
+	if (qcom_scm_pil_own_shmbridge())
+		qcom_tzmem_free(ctx->ptr);
+	else
+		dma_free_coherent(__scm->dev, ctx->size, ctx->ptr, ctx->phys);
 
 	ctx->ptr = NULL;
 	ctx->phys = 0;
@@ -757,7 +813,7 @@
 		.args[0] = pas_id,
 		.owner = ARM_SMCCC_OWNER_SIP,
 	};
-	struct qcom_scm_res res;
+	struct qcom_scm_res res = {};
 
 	ret = qcom_scm_clk_enable();
 	if (ret)
@@ -773,6 +829,8 @@
 disable_clk:
 	qcom_scm_clk_disable();
 
+	if (ret || res.result[0])
+		dev_err(__scm->dev, "pas_auth_and_reset(%u) ret=%d tz_result=%#llx\n", pas_id, ret, (u64)res.result[0]);
 	return ret ? : res.result[0];
 }
 EXPORT_SYMBOL_GPL(qcom_scm_pas_auth_and_reset);
