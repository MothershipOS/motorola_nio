diff -ruN a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
--- a/drivers/firmware/qcom/qcom_scm.c	2026-10-08 13:16:22.185721503 +0200
+++ b/drivers/firmware/qcom/qcom_scm.c	2026-10-08 13:18:29.077736698 +0200
@@ -35,6 +35,46 @@
 #include "qcom_scm.h"
 #include "qcom_tzmem.h"
 
+#include <asm/virt.h>
+
+/*
+ * mothershipOS: with Linux running at EL2 there is no Qualcomm hypervisor (QHEE) to create SHM
+ * bridges for PIL metadata on our behalf, so allocate it from the SHM-bridge-backed tzmem pool.
+ */
+static bool qcom_scm_pil_own_shmbridge(void)
+{
+	return is_kernel_in_hyp_mode();
+}
+
+/* SHM bridges we created for PAS image regions (one per pas_id), see qcom_scm_pas_el2_bridge() */
+#define QCOM_SCM_PAS_MAX_ID 64
+static u64 qcom_scm_pas_bridge[QCOM_SCM_PAS_MAX_ID];
+
+/**
+ * qcom_scm_pas_el2_bridge() - share a PAS image region with TZ when Linux runs at EL2
+ * @pas_id: peripheral authentication service id
+ * @addr: physical start of the loaded image
+ * @size: size of the loaded image
+ *
+ * Without QHEE nobody else creates the SHM bridge TZ needs to read the image during
+ * auth_and_reset. No-op when not at EL2. Returns 0 or a negative errno.
+ */
+int qcom_scm_pas_el2_bridge(u32 pas_id, phys_addr_t addr, size_t size)
+{
+	int ret;
+
+	if (!qcom_scm_pil_own_shmbridge() || pas_id >= QCOM_SCM_PAS_MAX_ID)
+		return 0;
+	if (qcom_scm_pas_bridge[pas_id]) {
+		qcom_tzmem_shm_bridge_delete(qcom_scm_pas_bridge[pas_id]);
+		qcom_scm_pas_bridge[pas_id] = 0;
+	}
+	ret = qcom_tzmem_shm_bridge_create(addr, PAGE_ALIGN(size), &qcom_scm_pas_bridge[pas_id]);
+	pr_info("qcom_scm: pas %u: SHM bridge %pa+%#zx -> %d\n", pas_id, &addr, size, ret);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_pas_el2_bridge);
+
 static u32 download_mode;
 
 #define GIC_SPI_BASE        32
@@ -632,7 +672,7 @@
 		.args[0] = pas_id,
