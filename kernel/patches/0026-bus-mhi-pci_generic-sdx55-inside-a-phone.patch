+/*
+ * An SDX55 inside a phone ("fusion", SM8250 + X55: Motorola nio, Xiaomi alioth): no flash of its own. The host
+ * pushes sbl1 over BHI; the SBL then asks for the rest of the boot chain over Sahara (channels 2/3, mhi_sahara),
+ * logs on channel 25, and the running modem takes its NV (EFS) over channels 10/11. The device tree selects
+ * this (compatible "qcom,ext-sdx55m" on the modem's PCI node): the subsystem ID is that of a Foxconn card.
+ * Channel map as in the stock firmware's; the SBL and the AMSS raise no MSI for the higher vectors, so the
+ * control and bandwidth rings share vector 0 and the rings are polled (see the flashless support in the MHI
+ * core). Derived from the alioth bring-up (github.com/cancelledbit/alioth-modem, GPL-2.0).
+ */
+static bool fusion_poll = true;
+module_param(fusion_poll, bool, 0444);
+MODULE_PARM_DESC(fusion_poll, "Poll the event rings of a flashless modem (its MSIs for event rings do not arrive)");
+
+static const struct mhi_channel_config mhi_qcom_sdx55_fusion_channels[] = {
