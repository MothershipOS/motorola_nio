+
 	dev_info(&pdev->dev, "MHI PCI device found: %s\n", info->name);
 
 	/* mhi_pdev.mhi_cntrl must be zero-initialized */
@@ -1312,6 +1482,8 @@
 		return -ENOMEM;
 
 	INIT_WORK(&mhi_pdev->recovery_work, mhi_pci_recovery_work);
+	INIT_WORK(&mhi_pdev->mission_mode_work, mhi_pci_mission_mode_work);
+	mhi_pdev->sbl_bounce = info->sbl_bounce;
 
 	if (pdev->is_virtfn && info->vf_config)
 		mhi_cntrl_config = info->vf_config;
@@ -1347,6 +1519,12 @@
 	if (info->edl_trigger)
 		mhi_cntrl->edl_trigger = mhi_pci_generic_edl_trigger;
 
+	if (info->sbl_bounce) {
+		mhi_cntrl->bw_scale = mhi_pci_bw_scale;
+		mhi_cntrl->wait_for_sbl = true;
+		mhi_cntrl->poll_events = fusion_poll;
+	}
+
 	if (info->sideband_wake) {
 		mhi_cntrl->wake_get = mhi_pci_wake_get_nop;
 		mhi_cntrl->wake_put = mhi_pci_wake_put_nop;
@@ -1361,6 +1539,14 @@
 	if (err)
 		return err;
 
+	/* after the vectors: the doorbell address is in the capability then; before power-up: the SBL reads it */
+	if (info->sbl_bounce) {
+		mhi_pci_msi_map(mhi_pdev, pdev);
+		err = devm_add_action_or_reset(&pdev->dev, mhi_pci_msi_unmap, mhi_pdev);
+		if (err)
+			return err;
+	}
+
 	pci_set_drvdata(pdev, mhi_pdev);
 
 	/* Have stored pci confspace at hand for restore in sudden PCI error.
@@ -1421,6 +1607,7 @@
 	if (!pdev->is_virtfn)
 		timer_delete_sync(&mhi_pdev->health_check_timer);
 	cancel_work_sync(&mhi_pdev->recovery_work);
+	cancel_work_sync(&mhi_pdev->mission_mode_work);
 
 	if (test_and_clear_bit(MHI_PCI_DEV_STARTED, &mhi_pdev->status)) {
 		mhi_power_down(mhi_cntrl, true);
@@ -1572,7 +1759,7 @@
 		goto pci_suspend; /* Nothing to do at MHI level */
 
 	/* Transition to M3 state */
-	err = mhi_pm_suspend(mhi_cntrl);
+	err = mhi_pdev->force_suspend ? mhi_pm_suspend_force(mhi_cntrl) : mhi_pm_suspend(mhi_cntrl);
 	if (err) {
 		dev_err(&pdev->dev, "failed to suspend device: %d\n", err);
 		clear_bit(MHI_PCI_DEV_SUSPENDED, &mhi_pdev->status);
@@ -1683,6 +1870,34 @@
 	return 0;
 }
 
+/*
+ * A flashless SDX55 at mission mode: one forced M3/D3hot suspend and resume, as downstream does "so the device
+ * can switch to mission mode PCIe PHY settings". Without it the modem answers QMI but keeps its radio off
+ * (DeviceNotReady). Forced: every control channel has buffers queued by then.
+ */
+static void mhi_pci_mission_mode_work(struct work_struct *work)
+{
+	struct mhi_pci_device *mhi_pdev = container_of(work, struct mhi_pci_device, mission_mode_work);
+	struct pci_dev *pdev = to_pci_dev(mhi_pdev->mhi_cntrl.cntrl_dev);
+	int err;
+
+	msleep(200); /* the mission mode transition finishes first */
+	mhi_pdev->force_suspend = true;
+	err = mhi_pci_runtime_suspend(&pdev->dev);
+	mhi_pdev->force_suspend = false;
+	if (err) {
+		dev_warn(&pdev->dev, "mission mode suspend cycle: suspend failed: %d\n", err);
+		return;
+	}
+	pci_save_state(pdev);
+	pci_set_power_state(pdev, PCI_D3hot);
+	msleep(50);
+	pci_set_power_state(pdev, PCI_D0);
+	pci_restore_state(pdev);
+	err = mhi_pci_runtime_resume(&pdev->dev);
+	dev_info(&pdev->dev, "mission mode suspend cycle done (%d)\n", err);
+}
+
 static const struct dev_pm_ops mhi_pci_pm_ops = {
 	SET_RUNTIME_PM_OPS(mhi_pci_runtime_suspend, mhi_pci_runtime_resume, NULL)
 #ifdef CONFIG_PM_SLEEP
@@ -1705,7 +1920,75 @@
 	.driver.pm	= &mhi_pci_pm_ops,
 	.sriov_configure = pci_sriov_configure_simple,
 };
-module_pci_driver(mhi_pci_driver);
+/* A flashless modem's SBL boot log (channel BL) into the kernel log */
+static void mhi_pci_bl_dl_cb(struct mhi_device *mhi_dev, struct mhi_result *res)
+{
+	const char *buf = res->buf_addr;
+	size_t len = res->bytes_xferd, pos = 0;
+
+	if (res->transaction_status || !buf)
+		return;
+	while (pos < len) {
+		size_t end = pos;
+
+		while (end < len && buf[end] && buf[end] != '\n' && buf[end] != '\r')
+			end++;
+		if (end > pos)
+			dev_info(&mhi_dev->dev, "%.*s\n", (int)(end - pos), buf + pos);
+		pos = end + 1;
+	}
+}
+
+static void mhi_pci_bl_ul_cb(struct mhi_device *mhi_dev, struct mhi_result *res)
+{
+}
+
+static int mhi_pci_bl_probe(struct mhi_device *mhi_dev, const struct mhi_device_id *id)
+{
+	return mhi_prepare_for_transfer_autoqueue(mhi_dev);
+}
+
+static void mhi_pci_bl_remove(struct mhi_device *mhi_dev)
+{
+	mhi_unprepare_from_transfer(mhi_dev);
+}
+
+static const struct mhi_device_id mhi_pci_bl_match_table[] = {
+	{ .chan = "BL" },
+	{},
+};
+
+static struct mhi_driver mhi_pci_bl_driver = {
+	.id_table = mhi_pci_bl_match_table,
+	.probe = mhi_pci_bl_probe,
+	.remove = mhi_pci_bl_remove,
+	.ul_xfer_cb = mhi_pci_bl_ul_cb,
+	.dl_xfer_cb = mhi_pci_bl_dl_cb,
+	.driver = {
+		.name = "mhi_pci_bl",
+	},
+};
+
+static int __init mhi_pci_init(void)
+{
+	int err;
+
+	err = mhi_driver_register(&mhi_pci_bl_driver);
+	if (err)
+		return err;
+	err = pci_register_driver(&mhi_pci_driver);
+	if (err)
+		mhi_driver_unregister(&mhi_pci_bl_driver);
+	return err;
+}
+module_init(mhi_pci_init);
+
+static void __exit mhi_pci_exit(void)
+{
+	pci_unregister_driver(&mhi_pci_driver);
+	mhi_driver_unregister(&mhi_pci_bl_driver);
+}
+module_exit(mhi_pci_exit);
 
