 static const struct mhi_pci_dev_info mhi_qcom_sdx55_info = {
 	.name = "qcom-sdx55m",
 	.fw = "qcom/sdx55m/sbl1.mbn",
@@ -1031,8 +1133,62 @@
 	struct timer_list health_check_timer;
 	unsigned long status;
 	bool reset_on_remove;
+	/* flashless modem: the mission mode suspend cycle, the MSI doorbell mapping */
+	bool sbl_bounce;
+	bool force_suspend;
+	struct work_struct mission_mode_work;
+	struct iommu_domain *msi_domain;
+	unsigned long msi_iova;
 };
 
+static void mhi_pci_mission_mode_work(struct work_struct *work);
+
+/*
+ * The modem raises an MSI by writing to the address in its MSI capability, which the DesignWare host gives as a
+ * physical address; the modem sits behind the SMMU, so the write is translated as an IOVA and faults. Map the
+ * doorbell page onto itself in the modem's IOMMU domain.
+ */
+static void mhi_pci_msi_unmap(void *data)
+{
+	struct mhi_pci_device *mhi_pdev = data;
+
+	if (mhi_pdev->msi_domain)
+		iommu_unmap(mhi_pdev->msi_domain, mhi_pdev->msi_iova, PAGE_SIZE);
+	mhi_pdev->msi_domain = NULL;
+}
+
+static void mhi_pci_msi_map(struct mhi_pci_device *mhi_pdev, struct pci_dev *pdev)
+{
+	struct iommu_domain *domain;
+	u32 addr_lo = 0, addr_hi = 0;
+	u16 ctrl;
+
+	if (!pdev->msi_enabled || !pdev->msi_cap)
+		return;
+	pci_read_config_word(pdev, pdev->msi_cap + PCI_MSI_FLAGS, &ctrl);
+	pci_read_config_dword(pdev, pdev->msi_cap + PCI_MSI_ADDRESS_LO, &addr_lo);
+	if (ctrl & PCI_MSI_FLAGS_64BIT)
+		pci_read_config_dword(pdev, pdev->msi_cap + PCI_MSI_ADDRESS_HI, &addr_hi);
+	domain = iommu_get_domain_for_dev(&pdev->dev);
+	if (addr_hi || !addr_lo || !domain)
+		return;
+	if (iommu_map(domain, addr_lo & PAGE_MASK, addr_lo & PAGE_MASK, PAGE_SIZE,
+		      IOMMU_READ | IOMMU_WRITE | IOMMU_MMIO, GFP_KERNEL))
+		return;
+	mhi_pdev->msi_domain = domain;
+	mhi_pdev->msi_iova = addr_lo & PAGE_MASK;
+	dev_info(&pdev->dev, "MSI doorbell %#x mapped for the modem\n", addr_lo);
+}
+
+/*
+ * The modem's bandwidth requests: the answer is what matters (unanswered, it resets); the link is not retuned
+ * (downstream: msm_pcie_set_link_bandwidth).
+ */
+static int mhi_pci_bw_scale(struct mhi_controller *mhi_cntrl, struct mhi_link_info *link_info)
+{
+	return 0;
+}
