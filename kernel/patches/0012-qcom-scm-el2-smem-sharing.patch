+/*
+ * mothershipOS: at EL2 there is no Qualcomm hypervisor (QHEE). At boot QHEE shares memory that the
+ * remote processors need with them through TZ MEM_ASSIGN: the SMEM table of contents and partitions
+ * (SMP2P / GLINK FIFOs), cmd-db and TZ<->subsystem channel pages. Without that a DSP authenticates and
+ * leaves reset but then hangs silently. Replay the same assignments, listed in the scm node:
+ *
+ *	el2-mem-assign {
+ *		#address-cells = <2>; #size-cells = <2>;
+ *		smem-toc { reg = <0 0x80aff000 0 0x1000>; qcom,vmid-perms = <3 4>, <6 4>, ...; };
+ *	};
+ *
+ * Every region starts owned by HLOS (VMID 3) alone. Only done when Linux runs at EL2.
+ */
+static bool qcom_scm_el2_mem_assigned;
+
+static void qcom_scm_el2_mem_assign(struct qcom_scm *scm)
+{
+	struct device_node *list, *np;
+	struct qcom_scm_vmperm perms[16];
+	u32 pairs[32];
+	u64 src, addr, size;
+	int n, i, ret, ok = 0, failed = 0;
+
+	if (!is_kernel_in_hyp_mode() || qcom_scm_el2_mem_assigned)
+		return;
+	qcom_scm_el2_mem_assigned = true;
+	list = of_get_child_by_name(scm->dev->of_node, "el2-mem-assign");
+	if (!list)
+		return;
+	for_each_available_child_of_node(list, np) {
+		if (of_property_read_reg(np, 0, &addr, &size)) {
+			dev_err(scm->dev, "el2-mem-assign %pOFn: bad reg\n", np);
+			failed++;
+			continue;
+		}
+		n = of_property_count_u32_elems(np, "qcom,vmid-perms");
+		if (n <= 0 || n % 2 || n > ARRAY_SIZE(pairs) ||
+		    of_property_read_u32_array(np, "qcom,vmid-perms", pairs, n)) {
+			dev_err(scm->dev, "el2-mem-assign %pOFn: bad qcom,vmid-perms\n", np);
+			failed++;
+			continue;
+		}
+		for (i = 0; i < n / 2; i++) {
+			perms[i].vmid = pairs[2 * i];
+			perms[i].perm = pairs[2 * i + 1];
+		}
+		src = BIT(QCOM_SCM_VMID_HLOS);
+		ret = qcom_scm_assign_mem(addr, size, &src, perms, n / 2);
+		if (ret) {
+			dev_err(scm->dev, "el2-mem-assign %pOFn %#llx+%#llx: %d\n", np, addr, size, ret);
+			failed++;
+		} else {
+			ok++;
+		}
+	}
+	of_node_put(list);
+	dev_info(scm->dev, "EL2: assigned %d memory regions to remote VMs (%d failed)\n", ok, failed);
+}
 
