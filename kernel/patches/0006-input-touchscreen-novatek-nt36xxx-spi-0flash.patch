mothershipOS: Novatek NT36672C 0-flash SPI touchscreen (drm_panel follower, host fw download).
Protocol from Novatek GPL reference driver (Motorola nova_0flash_mmi, kernel-work/reference/).

--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -679,6 +679,17 @@
 	  To compile this driver as a module, choose M here: the
 	  module will be called mtouch.
 
+config TOUCHSCREEN_NOVATEK_NT36XXX_SPI
+	tristate "Novatek NT36xxx 0-flash SPI touchscreen"
+	depends on SPI && DRM_PANEL && OF
+	help
+	  Say Y here for Novatek NT36672C TDDI touch controllers on SPI that
+	  need their firmware downloaded by the host on every panel power-on
+	  (e.g. Motorola nio).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called novatek-nt36xxx-spi.
+
 config TOUCHSCREEN_NOVATEK_NVT_TS
 	tristate "Novatek NT11205 touchscreen support"
 	depends on I2C
