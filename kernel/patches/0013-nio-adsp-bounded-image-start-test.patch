+/* One bounded experiment, not a production ownership policy. Called with
+ * remoteproc serialization, after image loading and before authentication.
+ */
+static int nio_pas_image_start_test(struct qcom_pas *pas)
+{
+	struct qcom_scm_vmperm shared[] = {{3, 6}, {6, 6}};
+	struct qcom_scm_vmperm restored = {3, 7};
+	struct qcom_scm_vmperm readers[] = {{3, 4}, {6, 4}}, cmd_hlos = {3, 4};
+	u64 owners = BIT(3), cmd_owners = BIT(3), cmd_handle = 0;
+	struct device_node *node;
+	struct resource cmd;
+	bool cmd_shared = false, cmd_bridge = false;
+	int ret, shutdown, restore, cmd_restore;
+
+	if (!is_kernel_in_hyp_mode() || pas->pas_id != 1 ||
+	    !of_device_is_compatible(pas->dev->of_node, "qcom,sm8250-adsp-pas") ||
+	    pas->mem_phys != 0x8a100000 || pas->mem_size != 0x1d00000)
+		return -EINVAL;
+
+	/* Separate permission scope, root-only and disabled by default. */
+	if (nio_el2_cmdb_start_test) {
+		if (!nio_el2_image_hyp_caller) return -EINVAL;
+		node = of_find_compatible_node(NULL, NULL, "qcom,cmd-db");
+		if (!node) return -ENODEV;
+		ret = of_address_to_resource(node, 0, &cmd);
+		of_node_put(node);
+		if (ret || cmd.start != 0x80860000 || resource_size(&cmd) != 0x20000)
+			return -EINVAL;
+		/* Register target RO for HLOS before changing its NS access policy. */
+		if (nio_el2_cmdb_early_bridge)
+			ret = qcom_scm_nio_cmdb_test_take_bridge(&cmd_handle);
+		else
+			ret = qcom_scm_shm_bridge_create(cmd.start | 4, cmd.start | 4,
+							resource_size(&cmd) | BIT(9), 3, &cmd_handle);
+		dev_info(pas->dev, "nio image-start-test: CMD-DB RO bridge=%d\n", ret);
+		if (ret) return ret < 0 ? ret : -EIO;
+		cmd_bridge = true;
+		ret = nio_pas_hyp_assign(pas, cmd.start, resource_size(&cmd),
+					&cmd_owners, readers, 2);
+		dev_info(pas->dev, "nio image-start-test: CMD-DB RO share=%d owners=%#llx\n", ret, cmd_owners);
+		if (ret) goto restore_cmd;
+		cmd_shared = true;
+	}
+
+	if (nio_el2_image_hyp_caller)
+		ret = nio_pas_hyp_assign(pas, pas->mem_phys, pas->mem_size, &owners, shared, 2);
+	else
+		ret = qcom_scm_assign_mem(pas->mem_phys, pas->mem_size, &owners, shared, 2);
+	dev_info(pas->dev, "nio image-start-test: share=%d owners=%#llx\n", ret, owners);
+	if (ret) goto restore_cmd;
+	pas->nio_image_retained = true;
+
+	ret = qcom_scm_pas_auth_and_reset(pas->pas_id);
+	dev_info(pas->dev, "nio image-start-test: auth=%d\n", ret);
+	if (!ret) {
+		ret = qcom_q6v5_wait_for_start(&pas->q6v5, msecs_to_jiffies(5000));
+		dev_info(pas->dev, "nio image-start-test: ready=%d\n", ret);
+	}
+	shutdown = qcom_scm_pas_shutdown(pas->pas_id);
+	dev_info(pas->dev, "nio image-start-test: shutdown=%d\n", shutdown);
+	if (shutdown) {
+		dev_err(pas->dev, "nio image-start-test: kept shared; reboot required\n");
+		return shutdown;
+	}
+	if (nio_el2_image_hyp_caller)
+		restore = nio_pas_hyp_assign(pas, pas->mem_phys, pas->mem_size, &owners, &restored, 1);
+	else
+		restore = qcom_scm_assign_mem(pas->mem_phys, pas->mem_size, &owners, &restored, 1);
+	dev_info(pas->dev, "nio image-start-test: restore=%d owners=%#llx\n", restore, owners);
+	if (restore) ret = restore;
+	pas->nio_image_retained = !!restore;
+restore_cmd:
+	/* Shutdown succeeded or reset was never released. HLOS continues reading CMD-DB. */
+	if (cmd_shared) {
+		cmd_restore = nio_pas_hyp_assign(pas, cmd.start, resource_size(&cmd),
+						&cmd_owners, &cmd_hlos, 1);
+		dev_info(pas->dev, "nio image-start-test: CMD-DB HLOS RO restore=%d owners=%#llx\n", cmd_restore, cmd_owners);
+		if (cmd_restore) { pas->nio_image_retained = true; ret = cmd_restore; }
+	}
+	if (cmd_bridge) {
+		cmd_restore = qcom_scm_shm_bridge_delete(cmd_handle);
+		dev_info(pas->dev, "nio image-start-test: CMD-DB bridge delete=%d\n", cmd_restore);
+		if (cmd_restore) { pas->nio_image_retained = true; ret = cmd_restore; }
+	}
+	if (pas->nio_image_retained)
+		dev_err(pas->dev, "nio image-start-test: kept shared; reboot required\n");
+	/* Even a ready success is stopped; no persistent DSP ownership policy. */
+	return ret ? ret : -EAGAIN;
+}
