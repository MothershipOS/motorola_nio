+/* Diagnostic HYP-caller assignment. Only private descriptor storage is
+ * additionally shared with VMID4; the target remains the approved ADSP image.
+ */
+static int nio_pas_hyp_assign(struct qcom_pas *pas, phys_addr_t base, size_t bytes,
+			      u64 *owners,
+			      struct qcom_scm_vmperm *dest, int count)
+{
+	struct qcom_scm_vmperm descriptor_shared[] = { {3, 6}, {4, 6} };
+	struct qcom_scm_vmperm hlos = {3, 7};
+	struct arm_smccc_res result;
+	__le32 *src, *dst;
+	__le64 *region, *extra;
+	dma_addr_t pa;
+	void *buf;
+	u64 descriptor_owners = BIT(3), handle = 0, new_owners = 0;
+	int ret, clean, i, n = 0;
+	bool bridge = false, unsafe = false;
+
+	if (!((base == 0x8a100000 && bytes == 0x1d00000) ||
+	      (base == 0x80860000 && bytes == 0x20000)))
+		return -EINVAL;
+	if (*owners & ~(BIT_ULL(3) | BIT_ULL(6)))
+		return -EINVAL;
+	buf = dma_alloc_coherent(pas->dev, PAGE_SIZE, &pa, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	memset(buf, 0, PAGE_SIZE);
+	src = buf; region = buf + 64; dst = buf + 128; extra = buf + 192;
+	for (i = 0; i < 64; i++)
+		if (*owners & BIT_ULL(i))
+			src[n++] = cpu_to_le32(i);
+	/* The bounded test only uses owners 3 and 6 and up to two destinations. */
+	if (!n || n > 2 || count < 1 || count > 2) { ret = -EINVAL; goto out; }
+	region[0] = cpu_to_le64(base);
+	region[1] = cpu_to_le64(bytes);
+	for (i = 0; i < count; i++) {
+		dst[6*i] = cpu_to_le32(dest[i].vmid);
+		dst[6*i+1] = cpu_to_le32(dest[i].perm);
+		new_owners |= BIT_ULL(dest[i].vmid);
+	}
+	extra[0] = cpu_to_le64(4*n);
+	extra[1] = cpu_to_le64(pa + 128);
+	extra[2] = cpu_to_le64(24*count);
+
+	ret = qcom_scm_assign_mem(pa, PAGE_SIZE, &descriptor_owners,
+				 descriptor_shared, 2);
+	if (ret) goto out;
+	ret = qcom_scm_shm_bridge_create(pa | 6, pa | 6,
+					PAGE_SIZE | BIT(9), 4, &handle);
+	if (ret) goto restore_descriptor;
+	bridge = true;
+	wmb();
+	arm_smccc_smc(0xc2000c16, 0x1117, pa+64, 16, pa, pa+192, 0, 0, &result);
+	dev_info(pas->dev, "nio HYP assign %pa+%#zx: a0=%#lx a1=%#lx\n", &base, bytes, result.a0, result.a1);
+	ret = result.a0 || result.a1 ? -EIO : 0;
+	if (!ret) *owners = new_owners;
+restore_descriptor:
+	if (bridge) {
+		clean = qcom_scm_shm_bridge_delete(handle);
+		dev_info(pas->dev, "nio HYP descriptor bridge delete=%d\n", clean);
+		if (clean) unsafe = true;
+	}
+	clean = qcom_scm_assign_mem(pa, PAGE_SIZE, &descriptor_owners, &hlos, 1);
+	dev_info(pas->dev, "nio HYP descriptor restore=%d\n", clean);
+	if (clean) unsafe = true;
+out:
+	if (!unsafe)
+		dma_free_coherent(pas->dev, PAGE_SIZE, buf, pa);
+	else
+		dev_err(pas->dev, "nio HYP descriptor page retained; reboot to clear private allocation\n");
+	/* Never mask target success: the caller must still shutdown/restore it. */
+	return ret;
+}
