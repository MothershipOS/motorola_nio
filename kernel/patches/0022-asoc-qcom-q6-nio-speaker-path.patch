+static int q6core_topo_cmd(struct q6core *core, u32 opcode, const void *payload, size_t len)
+{
+	struct apr_pkt *pkt;
+	int ret, size = APR_HDR_SIZE + len;
+
+	pkt = kzalloc(size, GFP_KERNEL);
+	if (!pkt)
+		return -ENOMEM;
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD, APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	pkt->hdr.pkt_size = size;
+	pkt->hdr.opcode = opcode;
+	memcpy(pkt->payload, payload, len);
+	core->topo_rsp = false;
+	ret = apr_send_pkt(core->adev, pkt);
+	kfree(pkt);
+	if (ret < 0)
+		return ret;
+	if (!wait_event_timeout(core->wait, core->topo_rsp, msecs_to_jiffies(1000)))
+		return -ETIMEDOUT;
+	if (core->last_opcode != opcode || core->last_status)
+		return -EIO;
+	return 0;
+}
+
+/*
+ * mothershipOS: register the ACDB custom topology list (AVCS v2 definitions) with the DSP, as the
+ * Android ACDB loader does at boot. AFE ports can then select e.g. the speaker-protection topologies.
+ */
+static void q6core_topo_work(struct work_struct *work)
+{
+	struct q6core *core = container_of(work, struct q6core, topo_work);
+	struct device *dev = &core->adev->dev;
+	struct avcs_cmd_register_topologies reg = {};
+	struct avcs_cmd_shared_mem_map map = {};
+	const struct firmware *fw;
+	size_t len;
+	dma_addr_t pa;
+	void *buf;
+	int ret;
+
+	if (!q6core_is_adsp_ready()) {
+		dev_err(dev, "custom topologies: ADSP not ready\n");
+		return;
+	}
+	ret = request_firmware(&fw, core->topo_fw, dev);
+	if (ret)
+		return;
+	len = PAGE_ALIGN(fw->size);
+	dma_coerce_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	buf = dma_alloc_coherent(dev, len, &pa, GFP_KERNEL);
+	if (!buf) {
+		release_firmware(fw);
+		return;
+	}
+	memcpy(buf, fw->data, fw->size);
+
+	map.mem_pool_id = ADSP_MEMORY_MAP_SHMEM8_4K_POOL;
+	map.num_regions = 1;
+	map.shm_addr_lsw = lower_32_bits(pa);
+	map.shm_addr_msw = upper_32_bits(pa);
+	map.mem_size_bytes = len;
+	mutex_lock(&core->lock);
+	ret = q6core_topo_cmd(core, AVCS_CMD_SHARED_MEM_MAP_REGIONS, &map, sizeof(map));
+	if (!ret) {
+		reg.payload_addr_lsw = lower_32_bits(pa);
+		reg.payload_addr_msw = upper_32_bits(pa);
+		reg.mem_map_handle = core->mem_map_handle;
+		reg.payload_size = fw->size;
+		ret = q6core_topo_cmd(core, AVCS_CMD_REGISTER_TOPOLOGIES, &reg, sizeof(reg));
+		dev_info(dev, "custom topologies %s (%zu bytes): %d (status %#x)\n",
+			 core->topo_fw, fw->size, ret, core->last_status);
+		q6core_topo_cmd(core, AVCS_CMD_SHARED_MEM_UNMAP_REGIONS, &core->mem_map_handle, 4);
+	} else {
+		dev_err(dev, "custom topologies: memory map failed %d\n", ret);
+	}
+	mutex_unlock(&core->lock);
+	dma_free_coherent(dev, len, buf, pa);
+	release_firmware(fw);
+}
