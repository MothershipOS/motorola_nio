#!/bin/busybox sh
# SPDX-License-Identifier: MIT
# RAM-only nio bring-up init. Never mounts persistent phone storage.
# Exposes a root shell on a USB CDC-ACM gadget (host: /dev/ttyACM*), and
# returns to fastboot if no host attaches within the timeout.

ATTACH_TIMEOUT=180
/bin/busybox mkdir -p /proc /sys /dev /tmp /run /sbin /usr/bin /usr/sbin
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config
mount -t pstore pstore /sys/fs/pstore 2>/dev/null

log() { echo "mothership-nio: $*" > /dev/kmsg; }
log "INIT_REACHED revision=2 kernel=$(uname -r); persistent storage is not mounted"
log "$(nio-diag kvm 2>&1)"

udc=""
for i in $(seq 1 60); do
	udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
	[ -n "$udc" ] && break
	sleep 0.5
done
if [ -z "$udc" ]; then
	log "USB_UDC_MISSING; see dmesg on screen"
else
	g=/sys/kernel/config/usb_gadget/nio
	mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409 $g/functions/acm.usb0
	echo 0x1d6b > $g/idVendor
	echo 0x0104 > $g/idProduct
	echo mothership-nio-diag > $g/strings/0x409/serialnumber
	echo mothershipOS > $g/strings/0x409/manufacturer
	echo "nio bring-up console" > $g/strings/0x409/product
	echo "ACM shell" > $g/configs/c.1/strings/0x409/configuration
	ln -s $g/functions/acm.usb0 $g/configs/c.1/
	echo "$udc" > $g/UDC && log "USB_GADGET_BOUND udc=$udc" || log "USB_GADGET_BIND_FAILED udc=$udc"
	(
		while true; do
			[ -c /dev/ttyGS0 ] && setsid -c sh -i <>/dev/ttyGS0 >&0 2>&0
			sleep 1
		done
	) &
fi

# The host tool creates /tmp/host-attached on its first command.
(
	sleep $ATTACH_TIMEOUT
	if [ ! -e /tmp/host-attached ]; then
		log "NO_HOST_ATTACH after ${ATTACH_TIMEOUT}s; rebooting to bootloader"
		sleep 5
		nio-diag reboot bootloader
	fi
) &

while true; do sleep 3600; done
